  "originalHtml": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>正方形的面积 - 小学一年级数学</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            font-family: 'Microsoft YaHei', '微软雅黑', Arial, sans-serif;\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n            min-height: 100vh;\n            padding: 20px;\n        }\n\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        header {\n            text-align: center;\n            color: white;\n            margin-bottom: 40px;\n            animation: fadeInDown 1s;\n        }\n\n        header h1 {\n            font-size: 48px;\n            margin-bottom: 10px;\n            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);\n        }\n\n        header p {\n            font-size: 18px;\n            opacity: 0.9;\n        }\n\n        .card {\n            background: white;\n            border-radius: 20px;\n            padding: 30px;\n            margin-bottom: 30px;\n            box-shadow: 0 10px 30px rgba(0,0,0,0.2);\n            animation: fadeInUp 1s;\n        }\n\n        .card h2 {\n            font-size: 32px;\n            color: #667eea;\n            margin-bottom: 20px;\n            padding-bottom: 10px;\n            border-bottom: 3px solid #667eea;\n        }\n\n        /* 概念讲解模块 */\n        #concept {\n            background: linear-gradient(135deg, #fff 0%, #f0f4ff 100%);\n        }\n\n        .concept-content {\n            font-size: 18px;\n            line-height: 1.8;\n            color: #333;\n        }\n\n        .formula-box {\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n            color: white;\n            padding: 30px;\n            border-radius: 15px;\n            margin: 20px 0;\n            text-align: center;\n            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);\n        }\n\n        .formula-box .main-formula {\n            font-size: 36px;\n            font-weight: bold;\n            margin-bottom: 15px;\n        }\n\n        .formula-box .sub-text {\n            font-size: 16px;\n            opacity: 0.95;\n            line-height: 1.6;\n        }\n\n        .key-points {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n            gap: 20px;\n            margin-top: 20px;\n        }\n\n        .point-item {\n            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);\n            color: white;\n            padding: 20px;\n            border-radius: 10px;\n            transition: transform 0.3s;\n        }\n\n        .point-item:hover {\n            transform: translateY(-5px);\n        }\n\n        .point-item h3 {\n            font-size: 20px;\n            margin-bottom: 10px;\n        }\n\n        .point-item p {\n            font-size: 14px;\n            line-height: 1.6;\n        }\n\n        /* 图形演示模块 */\n        #demo {\n            background: linear-gradient(135deg, #fff 0%, #e8f5e9 100%);\n        }\n\n        .canvas-container {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            flex-direction: column;\n            margin: 30px 0;\n        }\n\n        #squareCanvas {\n            border: 3px solid #667eea;\n            border-radius: 10px;\n            background: white;\n            box-shadow: 0 5px 15px rgba(0,0,0,0.1);\n        }\n\n        .controls {\n            margin-top: 20px;\n            display: flex;\n            gap: 15px;\n            align-items: center;\n            flex-wrap: wrap;\n            justify-content: center;\n        }\n\n        .controls label {\n            font-size: 18px;\n            font-weight: bold;\n            color: #333;\n        }\n\n        .controls input[type=\"range\"] {\n            width: 200px;\n            height: 8px;\n            border-radius: 4px;\n            outline: none;\n            -webkit-appearance: none;\n            background: linear-gradient(90deg, #667eea, #764ba2);\n        }\n\n        .controls input[type=\"range\"]::-webkit-slider-thumb {\n            -webkit-appearance: none;\n            width: 20px;\n            height: 20px;\n            border-radius: 50%;\n            background: white;\n            border: 3px solid #667eea;\n            cursor: pointer;\n            box-shadow: 0 2px 6px rgba(0,0,0,0.2);\n        }\n\n        .result-display {\n            background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);\n            color: white;\n            padding: 15px 30px;\n            border-radius: 10px;\n            font-size: 24px;\n            font-weight: bold;\n            box-shadow: 0 3px 10px rgba(76, 175, 80, 0.3);\n        }\n\n        /* 练习测试模块 */\n        #exercise {\n            background: linear-gradient(135deg, #fff 0%, #fff3e0 100%);\n        }\n\n        .question-container {\n            background: white;\n            border: 2px solid #667eea;\n            border-radius: 15px;\n            padding: 25px;\n            margin: 20px 0;\n        }\n\n        .question {\n            font-size: 24px;\n            color: #333;\n            margin-bottom: 20px;\n            display: flex;\n            align-items: center;\n            gap: 15px;\n        }\n\n        .question-number {\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n            color: white;\n            width: 50px;\n            height: 50px;\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 24px;\n            font-weight: bold;\n            flex-shrink: 0;\n        }\n\n        .answer-input {\n            display: flex;\n            gap: 10px;\n            align-items: center;\n            flex-wrap: wrap;\n        }\n\n        .answer-input input[type=\"number\"] {\n            width: 120px;\n            height: 50px;\n            font-size: 24px;\n            padding: 10px;\n            border: 3px solid #ddd;\n            border-radius: 10px;\n            text-align: center;\n            transition: border-color 0.3s;\n        }\n\n        .answer-input input[type=\"number\"]:focus {\n            outline: none;\n            border-color: #667eea;\n        }\n\n        .answer-input button {\n            background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);\n            color: white;\n            border: none;\n            padding: 12px 30px;\n            font-size: 18px;\n            border-radius: 10px;\n            cursor: pointer;\n            transition: all 0.3s;\n            box-shadow: 0 3px 10px rgba(76, 175, 80, 0.3);\n        }\n\n        .answer-input button:hover {\n            transform: translateY(-2px);\n            box-shadow: 0 5px 15px rgba(76, 175, 80, 0.4);\n        }\n\n        .feedback {\n            margin-top: 15px;\n            padding: 15px;\n            border-radius: 10px;\n            font-size: 18px;\n            font-weight: bold;\n            display: none;\n        }\n\n        .feedback.correct {\n            background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);\n            color: white;\n            display: block;\n            animation: bounceIn 0.5s;\n        }\n\n        .feedback.incorrect {\n            background: linear-gradient(135deg, #f44336 0%, #d32f2f 100%);\n            color: white;\n            display: block;\n            animation: shake 0.5s;\n        }\n\n        .score-board {\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n            color: white;\n            padding: 20px;\n            border-radius: 15px;\n            text-align: center;\n            margin-top: 30px;\n        }\n\n        .score-board h3 {\n            font-size: 24px;\n            margin-bottom: 10px;\n        }\n\n        .score-value {\n            font-size: 48px;\n            font-weight: bold;\n        }\n\n        /* 动画效果 */\n        @keyframes fadeInDown {\n            from {\n                opacity: 0;\n                transform: translateY(-30px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        @keyframes fadeInUp {\n            from {\n                opacity: 0;\n                transform: translateY(30px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        @keyframes bounceIn {\n            0% {\n                transform: scale(0.5);\n                opacity: 0;\n            }\n            70% {\n                transform: scale(1.1);\n            }\n            100% {\n                transform: scale(1);\n                opacity: 1;\n            }\n        }\n\n        @keyframes shake {\n            0%, 100% {\n                transform: translateX(0);\n            }\n            25% {\n                transform: translateX(-10px);\n            }\n            75% {\n                transform: translateX(10px);\n            }\n        }\n\n        .highlight {\n            background: yellow;\n            padding: 2px 5px;\n            border-radius: 3px;\n        }\n\n        .example-box {\n            background: #f5f5f5;\n            border-left: 5px solid #667eea;\n            padding: 20px;\n            margin: 20px 0;\n            border-radius: 5px;\n        }\n\n        .example-box h4 {\n            color: #667eea;\n            margin-bottom: 10px;\n            font-size: 20px;\n        }\n\n        .example-box p {\n            font-size: 18px;\n            line-height: 1.6;\n        }\n\n        footer {\n            text-align: center;\n            color: white;\n            margin-top: 40px;\n            padding: 20px;\n            font-size: 14px;\n            opacity: 0.8;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <header>\n            <h1>📐 正方形的面积</h1>\n            <p>小学一年级数学 | 探索图形的奥秘</p>\n        </header>\n\n        <!-- 概念讲解模块 -->\n        <div id=\"concept\" class=\"card\">\n            <h2>📖 概念讲解</h2>\n            \n            <div class=\"concept-content\">\n                <p>小朋友们，今天我们来学习<strong>正方形的面积</strong>怎么计算！</p>\n                \n                <div class=\"formula-box\">\n                    <div class=\"main-formula\">S = a × a = a²</div>\n                    <div class=\"sub-text\">\n                        正方形的面积 = 边长 × 边长<br>\n                        S 表示正方形的面积<br>\n                        a 表示正方形的边长\n                    </div>\n                </div>\n\n                <h3 style=\"margin: 20px 0 15px; color: #667eea;\">✨ 什么是正方形？</h3>\n                <p>正方形是一种特殊的四边形，它有<strong>四条相等的边</strong>和<strong>四个直角</strong>。</p>\n                <p style=\"margin-top: 10px;\">因为正方形的长和宽都相等（都叫做\"边长\"），所以正方形的面积就是：</p>\n                \n                <div class=\"example-box\">\n                    <h4>💡 计算示例</h4>\n                    <p>如果一个正方形的边长是 <span class=\"highlight\">5厘米</span>，那么它的面积是多少？</p>\n                    <p style=\"margin-top: 10px;\"><strong>解答：</strong></p>\n                    <p>面积 = 边长 × 边长 = 5 × 5 = <span class=\"highlight\">25 平方厘米</span></p>\n                    <p>我们也可以写成：S = 5² = 25 平方厘米</p>\n                </div>\n\n                <div class=\"key-points\">\n                    <div class=\"point-item\">\n                        <h3>📌 要点一</h3>\n                        <p>正方形的四条边长度都相等</p>\n                    </div>\n                    <div class=\"point-item\">\n                        <h3>📌 要点二</h3>\n                        <p>正方形的四个角都是直角（90度）</p>\n                    </div>\n                    <div class=\"point-item\">\n                        <h3>📌 要点三</h3>\n                        <p>知道边长就能算出面积</p>\n                    </div>\n                    <div class=\"point-item\">\n                        <h3>📌 要点四</h3>\n                        <p>面积单位用\"平方\"表示</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- 图形演示模块 -->\n        <div id=\"demo\" class=\"card\">\n            <h2>🎨 图形演示</h2>\n            \n            <div class=\"canvas-container\">\n                <canvas id=\"squareCanvas\" width=\"400\" height=\"400\"></canvas>\n                \n                <div class=\"controls\">\n                    <label for=\"sideLength\">调整边长：</label>\n                    <input type=\"range\" id=\"sideLength\" min=\"1\" max=\"10\" value=\"5\">\n                    <div class=\"result-display\">\n                        边长: <span id=\"sideValue\">5</span> 厘米 | 面积: <span id=\"areaValue\">25</span> 平方厘米\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"example-box\">\n                <h4>🔍 观察提示</h4>\n                <p>1. 拖动滑块可以改变正方形的边长</p>\n                <p>2. 观察边长和面积的变化关系</p>\n                <p>3. 看看面积是怎么计算出来的</p>\n            </div>\n        </div>\n\n        <!-- 练习测试模块 -->\n        <div id=\"exercise\" class=\"card\">\n            <h2>✏️ 练习测试</h2>\n            \n            <div class=\"question-container\">\n                <div class=\"question\">\n                    <div class=\"question-number\">1</div>\n                    <span>一个正方形的边长是 4 厘米，它的面积是多少平方厘米？</span>\n                </div>\n                <div class=\"answer-input\">\n                    <input type=\"number\" id=\"answer1\" placeholder=\"输入答案\">\n                    <button onclick=\"checkAnswer(1, 16)\">确定</button>\n                </div>\n                <div class=\"feedback\" id=\"feedback1\"></div>\n            </div>\n\n            <div class=\"question-container\">\n                <div class=\"question\">\n                    <div class=\"question-number\">2</div>\n                    <span>一个正方形的边长是 6 厘米，它的面积是多少平方厘米？</span>\n                </div>\n                <div class=\"answer-input\">\n                    <input type=\"number\" id=\"answer2\" placeholder=\"输入答案\">\n                    <button onclick=\"checkAnswer(2, 36)\">确定</button>\n                </div>\n                <div class=\"feedback\" id=\"feedback2\"></div>\n            </div>\n\n            <div class=\"question-container\">\n                <div class=\"question\">\n                    <div class=\"question-number\">3</div>\n                    <span>一个正方形的边长是 8 厘米，它的面积是多少平方厘米？</span>\n                </div>\n                <div class=\"answer-input\">\n                    <input type=\"number\" id=\"answer3\" placeholder=\"输入答案\">\n                    <button onclick=\"checkAnswer(3, 64)\">确定</button>\n                </div>\n                <div class=\"feedback\" id=\"feedback3\"></div>\n            </div>\n\n            <div class=\"question-container\">\n                <div class=\"question\">\n                    <div class=\"question-number\">4</div>\n                    <span>一个正方形的边长是 3 厘米，它的面积是多少平方厘米？</span>\n                </div>\n                <div class=\"answer-input\">\n                    <input type=\"number\" id=\"answer4\" placeholder=\"输入答案\">\n                    <button onclick=\"checkAnswer(4, 9)\">确定</button>\n                </div>\n                <div class=\"feedback\" id=\"feedback4\"></div>\n            </div>\n\n            <div class=\"question-container\">\n                <div class=\"question\">\n                    <div class=\"question-number\">5</div>\n                    <span>一个正方形的边长是 7 厘米，它的面积是多少平方厘米？</span>\n                </div>\n                <div class=\"answer-input\">\n                    <input type=\"number\" id=\"answer5\" placeholder=\"输入答案\">\n                    <button onclick=\"checkAnswer(5, 49)\">确定</button>\n                </div>\n                <div class=\"feedback\" id=\"feedback5\"></div>\n            </div>\n\n            <div class=\"score-board\">\n                <h3>🏆 你的得分</h3>\n                <div class=\"score-value\"><span id=\"score\">0</span> / 5</div>\n            </div>\n        </div>\n\n        <footer>\n            <p>© 2024 小学数学互动课件 | 正方形的面积</p>\n        </footer>\n    </div>\n\n    <script>\n        // 初始化画布\n        const canvas = document.getElementById('squareCanvas');\n        const ctx = canvas.getContext('2d');\n        const sideSlider = document.getElementById('sideLength');\n        const sideValueDisplay = document.getElementById('sideValue');\n        const areaValueDisplay = document.getElementById('areaValue');\n\n        // 绘制正方形\n        function drawSquare(sideLength) {\n            ctx.clearRect(0, 0, canvas.width, canvas.height);\n            \n            // 计算缩放比例\n            const maxSize = Math.min(canvas.width, canvas.height) - 80;\n            const scale = maxSize / 10;\n            const squareSize = sideLength * scale;\n            \n            // 计算居中位置\n            const x = (canvas.width - squareSize) / 2;\n            const y = (canvas.height - squareSize) / 2;\n            \n            // 绘制填充的正方形\n            const gradient = ctx.createLinearGradient(x, y, x + squareSize, y + squareSize);\n            gradient.addColorStop(0, '#667eea');\n            gradient.addColorStop(1, '#764ba2');\n            ctx.fillStyle = gradient;\n            ctx.fillRect(x, y, squareSize, squareSize);\n            \n            // 绘制边框\n            ctx.strokeStyle = '#4a5568';\n            ctx.lineWidth = 2;\n            ctx.strokeRect(x, y, squareSize, squareSize);\n            \n            // 绘制网格线（显示面积单位）\n            ctx.strokeStyle = 'rgba(255, 255, 255, 0.3)';\n            ctx.lineWidth = 1;\n            for (let i = 1; i < sideLength; i++) {\n                // 竖线\n                ctx.beginPath();\n                ctx.moveTo(x + i * scale, y);\n                ctx.lineTo(x + i * scale, y + squareSize);\n                ctx.stroke();\n                \n                // 横线\n                ctx.beginPath();\n                ctx.moveTo(x, y + i * scale);\n                ctx.lineTo(x + squareSize, y + i * scale);\n                ctx.stroke();\n            }\n            \n            // 标注边长\n            ctx.fillStyle = '#333';\n            ctx.font = 'bold 20px Microsoft YaHei';\n            ctx.textAlign = 'center';\n            ctx.textBaseline = 'middle';\n            \n            // 底部标注\n            ctx.fillText(`${sideLength}厘米`, canvas.width / 2, y + squareSize + 30);\n            \n            // 右侧标注\n            ctx.save();\n            ctx.translate(x + squareSize + 30, canvas.height / 2);\n            ctx.rotate(Math.PI / 2);\n            ctx.fillText(`${sideLength}厘米`, 0, 0);\n            ctx.restore();\n            \n            // 中心显示面积公式\n            ctx.fillStyle = 'white';\n            ctx.font = 'bold 24px Microsoft YaHei';\n            ctx.fillText(`${sideLength} × ${sideLength} = ${sideLength * sideLength}`, canvas.width / 2, canvas.height / 2);\n        }\n\n        // 滑块事件监听\n        sideSlider.addEventListener('input', function() {\n            const side = parseInt(this.value);\n            sideValueDisplay.textContent = side;\n            areaValueDisplay.textContent = side * side;\n            drawSquare(side);\n        });\n\n        // 初始绘制\n        drawSquare(5);\n\n        // 答题检查\n        let score = 0;\n        \n        function checkAnswer(questionNum, correctAnswer) {\n            const answerInput = document.getElementById(`answer${questionNum}`);\n            const feedback = document.getElementById(`feedback${questionNum}`);\n            const userAnswer = parseInt(answerInput.value);\n            \n            if (isNaN(userAnswer)) {\n                feedback.className = 'feedback incorrect';\n                feedback.textContent = '请输入一个数字！';\n                return;\n            }\n            \n            if (userAnswer === correctAnswer) {\n                feedback.className = 'feedback correct';\n                feedback.textContent = '✅ 太棒了！回答正确！';\n                if (!answerInput.dataset.answered) {\n                    score++;\n                    document.getElementById('score').textContent = score;\n                    answerInput.dataset.answered = 'true';\n                }\n            } else {\n                feedback.className = 'feedback incorrect';\n                feedback.textContent = `❌ 不对哦，再想想看。提示：${Math.sqrt(correctAnswer)} × ${Math.sqrt(correctAnswer)} = ?`;\n            }\n            \n            feedback.style.display = 'block';\n        }\n\n        // 回车键提交答案\n        document.querySelectorAll('input[type=\"number\"]').forEach(input => {\n            input.addEventListener('keypress', function(e) {\n                if (e.key === 'Enter') {\n                    const questionNum = parseInt(this.id.replace('answer', ''));\n                    const correctAnswers = [16, 36, 64, 9, 49];\n                    checkAnswer(questionNum, correctAnswers[questionNum - 1]);\n                }\n            });\n        });\n    </script>\n</body>\n</html>",
  "currentHtml": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>正方形的面积 - 小学一年级数学</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            font-family: 'Microsoft YaHei', '微软雅黑', Arial, sans-serif;\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n            min-height: 100vh;\n            padding: 20px;\n        }\n\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        header {\n            text-align: center;\n            color: white;\n            margin-bottom: 40px;\n            animation: fadeInDown 1s;\n        }\n\n        header h1 {\n            font-size: 48px;\n            margin-bottom: 10px;\n            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);\n        }\n\n        header p {\n            font-size: 18px;\n            opacity: 0.9;\n        }\n\n        .card {\n            background: white;\n            border-radius: 20px;\n            padding: 30px;\n            margin-bottom: 30px;\n            box-shadow: 0 10px 30px rgba(0,0,0,0.2);\n            animation: fadeInUp 1s;\n        }\n\n        .card h2 {\n            font-size: 32px;\n            color: #667eea;\n            margin-bottom: 20px;\n            padding-bottom: 10px;\n            border-bottom: 3px solid #667eea;\n        }\n\n        /* 概念讲解模块 */\n        #concept {\n            background: linear-gradient(135deg, #fff 0%, #f0f4ff 100%);\n        }\n\n        .concept-content {\n            font-size: 18px;\n            line-height: 1.8;\n            color: #333;\n        }\n\n        .formula-box {\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n            color: white;\n            padding: 30px;\n            border-radius: 15px;\n            margin: 20px 0;\n            text-align: center;\n            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);\n        }\n\n        .formula-box .main-formula {\n            font-size: 36px;\n            font-weight: bold;\n            margin-bottom: 15px;\n        }\n\n        .formula-box .sub-text {\n            font-size: 16px;\n            opacity: 0.95;\n            line-height: 1.6;\n        }\n\n        .key-points {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n            gap: 20px;\n            margin-top: 20px;\n        }\n\n        .point-item {\n            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);\n            color: white;\n            padding: 20px;\n            border-radius: 10px;\n            transition: transform 0.3s;\n        }\n\n        .point-item:hover {\n            transform: translateY(-5px);\n        }\n\n        .point-item h3 {\n            font-size: 20px;\n            margin-bottom: 10px;\n        }\n\n        .point-item p {\n            font-size: 14px;\n            line-height: 1.6;\n        }\n\n        /* 图形演示模块 */\n        #demo {\n            background: linear-gradient(135deg, #fff 0%, #e8f5e9 100%);\n        }\n\n        .canvas-container {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            flex-direction: column;\n            margin: 30px 0;\n        }\n\n        #squareCanvas {\n            border: 3px solid #667eea;\n            border-radius: 10px;\n            background: white;\n            box-shadow: 0 5px 15px rgba(0,0,0,0.1);\n        }\n\n        .controls {\n            margin-top: 20px;\n            display: flex;\n            gap: 15px;\n            align-items: center;\n            flex-wrap: wrap;\n            justify-content: center;\n        }\n\n        .controls label {\n            font-size: 18px;\n            font-weight: bold;\n            color: #333;\n        }\n\n        .controls input[type=\"range\"] {\n            width: 200px;\n            height: 8px;\n            border-radius: 4px;\n            outline: none;\n            -webkit-appearance: none;\n            background: linear-gradient(90deg, #667eea, #764ba2);\n        }\n\n        .controls input[type=\"range\"]::-webkit-slider-thumb {\n            -webkit-appearance: none;\n            width: 20px;\n            height: 20px;\n            border-radius: 50%;\n            background: white;\n            border: 3px solid #667eea;\n            cursor: pointer;\n            box-shadow: 0 2px 6px rgba(0,0,0,0.2);\n        }\n\n        .result-display {\n            background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);\n            color: white;\n            padding: 15px 30px;\n            border-radius: 10px;\n            font-size: 24px;\n            font-weight: bold;\n            box-shadow: 0 3px 10px rgba(76, 175, 80, 0.3);\n        }\n\n        /* 练习测试模块 */\n        #exercise {\n            background: linear-gradient(135deg, #fff 0%, #fff3e0 100%);\n        }\n\n        .question-container {\n            background: white;\n            border: 2px solid #667eea;\n            border-radius: 15px;\n            padding: 25px;\n            margin: 20px 0;\n        }\n\n        .question {\n            font-size: 24px;\n            color: #333;\n            margin-bottom: 20px;\n            display: flex;\n            align-items: center;\n            gap: 15px;\n        }\n\n        .question-number {\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n            color: white;\n            width: 50px;\n            height: 50px;\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 24px;\n            font-weight: bold;\n            flex-shrink: 0;\n        }\n\n        .answer-input {\n            display: flex;\n            gap: 10px;\n            align-items: center;\n            flex-wrap: wrap;\n        }\n\n        .answer-input input[type=\"number\"] {\n            width: 120px;\n            height: 50px;\n            font-size: 24px;\n            padding: 10px;\n            border: 3px solid #ddd;\n            border-radius: 10px;\n            text-align: center;\n            transition: border-color 0.3s;\n        }\n\n        .answer-input input[type=\"number\"]:focus {\n            outline: none;\n            border-color: #667eea;\n        }\n\n        .answer-input button {\n            background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);\n            color: white;\n            border: none;\n            padding: 12px 30px;\n            font-size: 18px;\n            border-radius: 10px;\n            cursor: pointer;\n            transition: all 0.3s;\n            box-shadow: 0 3px 10px rgba(76, 175, 80, 0.3);\n        }\n\n        .answer-input button:hover {\n            transform: translateY(-2px);\n            box-shadow: 0 5px 15px rgba(76, 175, 80, 0.4);\n        }\n\n        .feedback {\n            margin-top: 15px;\n            padding: 15px;\n            border-radius: 10px;\n            font-size: 18px;\n            font-weight: bold;\n            display: none;\n        }\n\n        .feedback.correct {\n            background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);\n            color: white;\n            display: block;\n            animation: bounceIn 0.5s;\n        }\n\n        .feedback.incorrect {\n            background: linear-gradient(135deg, #f44336 0%, #d32f2f 100%);\n            color: white;\n            display: block;\n            animation: shake 0.5s;\n        }\n\n        .score-board {\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n            color: white;\n            padding: 20px;\n            border-radius: 15px;\n            text-align: center;\n            margin-top: 30px;\n        }\n\n        .score-board h3 {\n            font-size: 24px;\n            margin-bottom: 10px;\n        }\n\n        .score-value {\n            font-size: 48px;\n            font-weight: bold;\n        }\n\n        /* 动画效果 */\n        @keyframes fadeInDown {\n            from {\n                opacity: 0;\n                transform: translateY(-30px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        @keyframes fadeInUp {\n            from {\n                opacity: 0;\n                transform: translateY(30px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        @keyframes bounceIn {\n            0% {\n                transform: scale(0.5);\n                opacity: 0;\n            }\n            70% {\n                transform: scale(1.1);\n            }\n            100% {\n                transform: scale(1);\n                opacity: 1;\n            }\n        }\n\n        @keyframes shake {\n            0%, 100% {\n                transform: translateX(0);\n            }\n            25% {\n                transform: translateX(-10px);\n            }\n            75% {\n                transform: translateX(10px);\n            }\n        }\n\n        .highlight {\n            background: yellow;\n            padding: 2px 5px;\n            border-radius: 3px;\n        }\n\n        .example-box {\n            background: #f5f5f5;\n            border-left: 5px solid #667eea;\n            padding: 20px;\n            margin: 20px 0;\n            border-radius: 5px;\n        }\n\n        .example-box h4 {\n            color: #667eea;\n            margin-bottom: 10px;\n            font-size: 20px;\n        }\n\n        .example-box p {\n            font-size: 18px;\n            line-height: 1.6;\n        }\n\n        footer {\n            text-align: center;\n            color: white;\n            margin-top: 40px;\n            padding: 20px;\n            font-size: 14px;\n            opacity: 0.8;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <header>\n            <h1>📐 正方形的面积</h1>\n            <p>小学一年级数学 | 探索图形的奥秘</p>\n        </header>\n\n        <!-- 概念讲解模块 -->\n        <div id=\"concept\" class=\"card\">\n            <h2>📖 概念讲解</h2>\n            \n            <div class=\"concept-content\">\n                <p>小朋友们，今天我们来学习<strong>正方形的面积</strong>怎么计算！</p>\n                \n                <div class=\"formula-box\">\n                    <div class=\"main-formula\">S = a × a = a²</div>\n                    <div class=\"sub-text\">\n                        正方形的面积 = 边长 × 边长<br>\n                        S 表示正方形的面积<br>\n                        a 表示正方形的边长\n                    </div>\n                </div>\n\n                <h3 style=\"margin: 20px 0 15px; color: #667eea;\">✨ 什么是正方形？</h3>\n                <p>正方形是一种特殊的四边形，它有<strong>四条相等的边</strong>和<strong>四个直角</strong>。</p>\n                <p style=\"margin-top: 10px;\">因为正方形的长和宽都相等（都叫做\"边长\"），所以正方形的面积就是：</p>\n                \n                <div class=\"example-box\">\n                    <h4>💡 计算示例</h4>\n                    <p>如果一个正方形的边长是 <span class=\"highlight\">5厘米</span>，那么它的面积是多少？</p>\n                    <p style=\"margin-top: 10px;\"><strong>解答：</strong></p>\n                    <p>面积 = 边长 × 边长 = 5 × 5 = <span class=\"highlight\">25 平方厘米</span></p>\n                    <p>我们也可以写成：S = 5² = 25 平方厘米</p>\n                </div>\n\n                <div class=\"key-points\">\n                    <div class=\"point-item\">\n                        <h3>📌 要点一</h3>\n                        <p>正方形的四条边长度都相等</p>\n                    </div>\n                    <div class=\"point-item\">\n                        <h3>📌 要点二</h3>\n                        <p>正方形的四个角都是直角（90度）</p>\n                    </div>\n                    <div class=\"point-item\">\n                        <h3>📌 要点三</h3>\n                        <p>知道边长就能算出面积</p>\n                    </div>\n                    <div class=\"point-item\">\n                        <h3>📌 要点四</h3>\n                        <p>面积单位用\"平方\"表示</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- 图形演示模块 -->\n        <div id=\"demo\" class=\"card\">\n            <h2>🎨 图形演示</h2>\n            \n            <div class=\"canvas-container\">\n                <canvas id=\"squareCanvas\" width=\"400\" height=\"400\"></canvas>\n                \n                <div class=\"controls\">\n                    <label for=\"sideLength\">调整边长：</label>\n                    <input type=\"range\" id=\"sideLength\" min=\"1\" max=\"10\" value=\"5\">\n                    <div class=\"result-display\">\n                        边长: <span id=\"sideValue\">5</span> 厘米 | 面积: <span id=\"areaValue\">25</span> 平方厘米\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"example-box\">\n                <h4>🔍 观察提示</h4>\n                <p>1. 拖动滑块可以改变正方形的边长</p>\n                <p>2. 观察边长和面积的变化关系</p>\n                <p>3. 看看面积是怎么计算出来的</p>\n            </div>\n        </div>\n\n        <!-- 练习测试模块 -->\n        <div id=\"exercise\" class=\"card\">\n            <h2>✏️ 练习测试</h2>\n            \n            <div class=\"question-container\">\n                <div class=\"question\">\n                    <div class=\"question-number\">1</div>\n                    <span>一个正方形的边长是 4 厘米，它的面积是多少平方厘米？</span>\n                </div>\n                <div class=\"answer-input\">\n                    <input type=\"number\" id=\"answer1\" placeholder=\"输入答案\">\n                    <button onclick=\"checkAnswer(1, 16)\">确定</button>\n                </div>\n                <div class=\"feedback\" id=\"feedback1\"></div>\n            </div>\n\n            <div class=\"question-container\">\n                <div class=\"question\">\n                    <div class=\"question-number\">2</div>\n                    <span>一个正方形的边长是 6 厘米，它的面积是多少平方厘米？</span>\n                </div>\n                <div class=\"answer-input\">\n                    <input type=\"number\" id=\"answer2\" placeholder=\"输入答案\">\n                    <button onclick=\"checkAnswer(2, 36)\">确定</button>\n                </div>\n                <div class=\"feedback\" id=\"feedback2\"></div>\n            </div>\n\n            <div class=\"question-container\">\n                <div class=\"question\">\n                    <div class=\"question-number\">3</div>\n                    <span>一个正方形的边长是 8 厘米，它的面积是多少平方厘米？</span>\n                </div>\n                <div class=\"answer-input\">\n                    <input type=\"number\" id=\"answer3\" placeholder=\"输入答案\">\n                    <button onclick=\"checkAnswer(3, 64)\">确定</button>\n                </div>\n                <div class=\"feedback\" id=\"feedback3\"></div>\n            </div>\n\n            <div class=\"question-container\">\n                <div class=\"question\">\n                    <div class=\"question-number\">4</div>\n                    <span>一个正方形的边长是 3 厘米，它的面积是多少平方厘米？</span>\n                </div>\n                <div class=\"answer-input\">\n                    <input type=\"number\" id=\"answer4\" placeholder=\"输入答案\">\n                    <button onclick=\"checkAnswer(4, 9)\">确定</button>\n                </div>\n                <div class=\"feedback\" id=\"feedback4\"></div>\n            </div>\n\n            <div class=\"question-container\">\n                <div class=\"question\">\n                    <div class=\"question-number\">5</div>\n                    <span>一个正方形的边长是 7 厘米，它的面积是多少平方厘米？</span>\n                </div>\n                <div class=\"answer-input\">\n                    <input type=\"number\" id=\"answer5\" placeholder=\"输入答案\">\n                    <button onclick=\"checkAnswer(5, 49)\">确定</button>\n                </div>\n                <div class=\"feedback\" id=\"feedback5\"></div>\n            </div>\n\n            <div class=\"score-board\">\n                <h3>🏆 你的得分</h3>\n                <div class=\"score-value\"><span id=\"score\">0</span> / 5</div>\n            </div>\n        </div>\n\n        <footer>\n            <p>© 2024 小学数学互动课件 | 正方形的面积</p>\n        </footer>\n    </div>\n\n    <script>\n        // 初始化画布\n        const canvas = document.getElementById('squareCanvas');\n        const ctx = canvas.getContext('2d');\n        const sideSlider = document.getElementById('sideLength');\n        const sideValueDisplay = document.getElementById('sideValue');\n        const areaValueDisplay = document.getElementById('areaValue');\n\n        // 绘制正方形\n        function drawSquare(sideLength) {\n            ctx.clearRect(0, 0, canvas.width, canvas.height);\n            \n            // 计算缩放比例\n            const maxSize = Math.min(canvas.width, canvas.height) - 80;\n            const scale = maxSize / 10;\n            const squareSize = sideLength * scale;\n            \n            // 计算居中位置\n            const x = (canvas.width - squareSize) / 2;\n            const y = (canvas.height - squareSize) / 2;\n            \n            // 绘制填充的正方形\n            const gradient = ctx.createLinearGradient(x, y, x + squareSize, y + squareSize);\n            gradient.addColorStop(0, '#667eea');\n            gradient.addColorStop(1, '#764ba2');\n            ctx.fillStyle = gradient;\n            ctx.fillRect(x, y, squareSize, squareSize);\n            \n            // 绘制边框\n            ctx.strokeStyle = '#4a5568';\n            ctx.lineWidth = 2;\n            ctx.strokeRect(x, y, squareSize, squareSize);\n            \n            // 绘制网格线（显示面积单位）\n            ctx.strokeStyle = 'rgba(255, 255, 255, 0.3)';\n            ctx.lineWidth = 1;\n            for (let i = 1; i < sideLength; i++) {\n                // 竖线\n                ctx.beginPath();\n                ctx.moveTo(x + i * scale, y);\n                ctx.lineTo(x + i * scale, y + squareSize);\n                ctx.stroke();\n                \n                // 横线\n                ctx.beginPath();\n                ctx.moveTo(x, y + i * scale);\n                ctx.lineTo(x + squareSize, y + i * scale);\n                ctx.stroke();\n            }\n            \n            // 标注边长\n            ctx.fillStyle = '#333';\n            ctx.font = 'bold 20px Microsoft YaHei';\n            ctx.textAlign = 'center';\n            ctx.textBaseline = 'middle';\n            \n            // 底部标注\n            ctx.fillText(`${sideLength}厘米`, canvas.width / 2, y + squareSize + 30);\n            \n            // 右侧标注\n            ctx.save();\n            ctx.translate(x + squareSize + 30, canvas.height / 2);\n            ctx.rotate(Math.PI / 2);\n            ctx.fillText(`${sideLength}厘米`, 0, 0);\n            ctx.restore();\n            \n            // 中心显示面积公式\n            ctx.fillStyle = 'white';\n            ctx.font = 'bold 24px Microsoft YaHei';\n            ctx.fillText(`${sideLength} × ${sideLength} = ${sideLength * sideLength}`, canvas.width / 2, canvas.height / 2);\n        }\n\n        // 滑块事件监听\n        sideSlider.addEventListener('input', function() {\n            const side = parseInt(this.value);\n            sideValueDisplay.textContent = side;\n            areaValueDisplay.textContent = side * side;\n            drawSquare(side);\n        });\n\n        // 初始绘制\n        drawSquare(5);\n\n        // 答题检查\n        let score = 0;\n        \n        function checkAnswer(questionNum, correctAnswer) {\n            const answerInput = document.getElementById(`answer${questionNum}`);\n            const feedback = document.getElementById(`feedback${questionNum}`);\n            const userAnswer = parseInt(answerInput.value);\n            \n            if (isNaN(userAnswer)) {\n                feedback.className = 'feedback incorrect';\n                feedback.textContent = '请输入一个数字！';\n                return;\n            }\n            \n            if (userAnswer === correctAnswer) {\n                feedback.className = 'feedback correct';\n                feedback.textContent = '✅ 太棒了！回答正确！';\n                if (!answerInput.dataset.answered) {\n                    score++;\n                    document.getElementById('score').textContent = score;\n                    answerInput.dataset.answered = 'true';\n                }\n            } else {\n                feedback.className = 'feedback incorrect';\n                feedback.textContent = `❌ 不对哦，再想想看。提示：${Math.sqrt(correctAnswer)} × ${Math.sqrt(correctAnswer)} = ?`;\n            }\n            \n            feedback.style.display = 'block';\n        }\n\n        // 回车键提交答案\n        document.querySelectorAll('input[type=\"number\"]').forEach(input => {\n            input.addEventListener('keypress', function(e) {\n                if (e.key === 'Enter') {\n                    const questionNum = parseInt(this.id.replace('answer', ''));\n                    const correctAnswers = [16, 36, 64, 9, 49];\n                    checkAnswer(questionNum, correctAnswers[questionNum - 1]);\n                }\n            });\n        });\n    </script>\n</body>\n</html>",
