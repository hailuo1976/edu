  "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>微积分演示</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n    <style>\n        :root {\n            --bg: #0a0f1a;\n            --bg-secondary: #111827;\n            --fg: #e8edf5;\n            --muted: #6b7994;\n            --accent: #00d4aa;\n            --accent-secondary: #ff6b6b;\n            --card: #151d2e;\n            --border: #2a3548;\n        }\n        \n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n        \n        body {\n            font-family: 'Space Grotesk', sans-serif;\n            background: var(--bg);\n            color: var(--fg);\n            min-height: 100vh;\n            overflow-x: hidden;\n        }\n        \n        .mono {\n            font-family: 'JetBrains Mono', monospace;\n        }\n        \n        .bg-gradient {\n            background: \n                radial-gradient(ellipse at 20% 0%, rgba(0, 212, 170, 0.08) 0%, transparent 50%),\n                radial-gradient(ellipse at 80% 100%, rgba(255, 107, 107, 0.06) 0%, transparent 50%),\n                var(--bg);\n        }\n        \n        .nav-btn {\n            position: relative;\n            padding: 0.75rem 1.5rem;\n            background: transparent;\n            border: 1px solid var(--border);\n            color: var(--muted);\n            border-radius: 8px;\n            cursor: pointer;\n            transition: all 0.3s ease;\n            font-family: 'Space Grotesk', sans-serif;\n            font-weight: 500;\n        }\n        \n        .nav-btn:hover {\n            border-color: var(--accent);\n            color: var(--fg);\n        }\n        \n        .nav-btn.active {\n            background: var(--accent);\n            border-color: var(--accent);\n            color: var(--bg);\n        }\n        \n        .module {\n            display: none;\n            animation: fadeIn 0.5s ease;\n        }\n        \n        .module.active {\n            display: block;\n        }\n        \n        @keyframes fadeIn {\n            from { opacity: 0; transform: translateY(20px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n        \n        .card {\n            background: var(--card);\n            border: 1px solid var(--border);\n            border-radius: 16px;\n            padding: 2rem;\n            transition: all 0.3s ease;\n        }\n        \n        .card:hover {\n            border-color: rgba(0, 212, 170, 0.3);\n            box-shadow: 0 8px 32px rgba(0, 212, 170, 0.1);\n        }\n        \n        .formula {\n            background: rgba(0, 212, 170, 0.1);\n            border: 1px solid rgba(0, 212, 170, 0.2);\n            border-radius: 8px;\n            padding: 1rem 1.5rem;\n            display: inline-block;\n            color: var(--accent);\n        }\n        \n        .canvas-container {\n            background: var(--bg-secondary);\n            border: 1px solid var(--border);\n            border-radius: 12px;\n            overflow: hidden;\n        }\n        \n        .control-btn {\n            padding: 0.5rem 1rem;\n            background: var(--card);\n            border: 1px solid var(--border);\n            color: var(--fg);\n            border-radius: 6px;\n            cursor: pointer;\n            transition: all 0.2s ease;\n            font-family: 'Space Grotesk', sans-serif;\n        }\n        \n        .control-btn:hover {\n            background: var(--accent);\n            border-color: var(--accent);\n            color: var(--bg);\n        }\n        \n        .slider {\n            -webkit-appearance: none;\n            width: 100%;\n            height: 6px;\n            background: var(--border);\n            border-radius: 3px;\n            outline: none;\n        }\n        \n        .slider::-webkit-slider-thumb {\n            -webkit-appearance: none;\n            width: 18px;\n            height: 18px;\n            background: var(--accent);\n            border-radius: 50%;\n            cursor: pointer;\n            transition: transform 0.2s ease;\n        }\n        \n        .slider::-webkit-slider-thumb:hover {\n            transform: scale(1.2);\n        }\n        \n        .quiz-option {\n            width: 100%;\n            padding: 1rem 1.5rem;\n            background: var(--card);\n            border: 2px solid var(--border);\n            border-radius: 10px;\n            text-align: left;\n            color: var(--fg);\n            cursor: pointer;\n            transition: all 0.3s ease;\n            font-family: 'Space Grotesk', sans-serif;\n            font-size: 1rem;\n        }\n        \n        .quiz-option:hover {\n            border-color: var(--accent);\n            background: rgba(0, 212, 170, 0.05);\n        }\n        \n        .quiz-option.correct {\n            border-color: var(--accent);\n            background: rgba(0, 212, 170, 0.15);\n        }\n        \n        .quiz-option.incorrect {\n            border-color: var(--accent-secondary);\n            background: rgba(255, 107, 107, 0.15);\n        }\n        \n        .progress-bar {\n            height: 4px;\n            background: var(--border);\n            border-radius: 2px;\n            overflow: hidden;\n        }\n        \n        .progress-fill {\n            height: 100%;\n            background: linear-gradient(90deg, var(--accent), var(--accent-secondary));\n            transition: width 0.5s ease;\n        }\n        \n        .floating-particle {\n            position: absolute;\n            width: 4px;\n            height: 4px;\n            background: var(--accent);\n            border-radius: 50%;\n            opacity: 0.3;\n            animation: float 8s infinite ease-in-out;\n        }\n        \n        @keyframes float {\n            0%, 100% { transform: translateY(0) translateX(0); opacity: 0.3; }\n            50% { transform: translateY(-30px) translateX(20px); opacity: 0.6; }\n        }\n        \n        @media (prefers-reduced-motion: reduce) {\n            .floating-particle, .module {\n                animation: none;\n            }\n            .nav-btn, .card, .quiz-option, .control-btn {\n                transition: none;\n            }\n        }\n        \n        @media (max-width: 768px) {\n            .nav-btn {\n                padding: 0.5rem 1rem;\n                font-size: 0.875rem;\n            }\n            .card {\n                padding: 1.25rem;\n            }\n        }\n    </style>\n</head>\n<body class=\"bg-gradient\">\n    <!-- Floating Particles -->\n    <div id=\"particles\" class=\"fixed inset-0 pointer-events-none overflow-hidden\"></div>\n    \n    <!-- Header -->\n    <header class=\"sticky top-0 z-50 backdrop-blur-xl bg-opacity-80\" style=\"background: rgba(10, 15, 26, 0.9);\">\n        <div class=\"max-w-6xl mx-auto px-4 py-4\">\n            <div class=\"flex flex-col sm:flex-row items-center justify-between gap-4\">\n                <h1 class=\"text-2xl font-bold\">\n                    <span style=\"color: var(--accent);\">Calc</span>ulus\n                </h1>\n                <nav class=\"flex gap-2 flex-wrap justify-center\">\n                    <button class=\"nav-btn active\" data-target=\"concept\" onclick=\"switchModule('concept')\">概念讲解</button>\n                    <button class=\"nav-btn\" data-target=\"demo\" onclick=\"switchModule('demo')\">图形演示</button>\n                    <button class=\"nav-btn\" data-target=\"exercise\" onclick=\"switchModule('exercise')\">练习测试</button>\n                </nav>\n            </div>\n        </div>\n    </header>\n    \n    <!-- Main Content -->\n    <main class=\"max-w-6xl mx-auto px-4 py-8\">\n        \n        <!-- Concept Module -->\n        <section id=\"concept\" class=\"module active\">\n            <div class=\"space-y-8\">\n                <div class=\"text-center space-y-4\">\n                    <h2 class=\"text-4xl sm:text-5xl font-bold\" style=\"color: var(--fg);\">微积分基础</h2>\n                    <p class=\"text-lg\" style=\"color: var(--muted);\">探索变化率与累积的数学之美</p>\n                </div>\n                \n                <!-- Derivative Section -->\n                <div class=\"grid md:grid-cols-2 gap-6\">\n                    <div class=\"card space-y-4\">\n                        <div class=\"flex items-center gap-3\">\n                            <div class=\"w-10 h-10 rounded-lg flex items-center justify-center\" style=\"background: rgba(0, 212, 170, 0.15);\">\n                                <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" style=\"color: var(--accent);\">\n                                    <path d=\"M22 12h-4l-3 9L9 3l-3 9H2\"/>\n                                </svg>\n                            </div>\n                            <h3 class=\"text-xl font-bold\">导数</h3>\n                        </div>\n                        <p style=\"color: var(--muted);\">导数描述函数在某一点的瞬时变化率，是微积分的核心概念之一。</p>\n                        <div class=\"formula mono text-lg\">\n                            f'(x) = lim<sub>h→0</sub> [f(x+h) - f(x)] / h\n                        </div>\n                        <p style=\"color: var(--muted);\">几何意义：曲线在该点切线的斜率</p>\n                    </div>\n                    \n                    <div class=\"card space-y-4\">\n                        <div class=\"flex items-center gap-3\">\n                            <div class=\"w-10 h-10 rounded-lg flex items-center justify-center\" style=\"background: rgba(255, 107, 107, 0.15);\">\n                                <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" style=\"color: var(--accent-secondary);\">\n                                    <rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/>\n                                    <path d=\"M3 9h18M9 21V9\"/>\n                                </svg>\n                            </div>\n                            <h3 class=\"text-xl font-bold\">积分</h3>\n                        </div>\n                        <p style=\"color: var(--muted);\">积分是导数的逆运算，用于计算曲线下的面积和累积量。</p>\n                        <div class=\"formula mono text-lg\" style=\"background: rgba(255, 107, 107, 0.1); border-color: rgba(255, 107, 107, 0.2); color: var(--accent-secondary);\">\n                            ∫<sub>a</sub><sup>b</sup> f(x) dx = F(b) - F(a)\n                        </div>\n                        <p style=\"color: var(--muted);\">几何意义：曲线与x轴之间的有向面积</p>\n                    </div>\n                </div>\n                \n                <!-- Key Concepts -->\n                <div class=\"card\">\n                    <h3 class=\"text-xl font-bold mb-6\">核心定理</h3>\n                    <div class=\"space-y-6\">\n                        <div class=\"p-4 rounded-lg\" style=\"background: var(--bg-secondary);\">\n                            <h4 class=\"font-bold mb-2\" style=\"color: var(--accent);\">微积分基本定理</h4>\n                            <p style=\"color: var(--muted);\" class=\"mb-3\">建立了微分与积分之间的桥梁，揭示了它们互为逆运算的关系。</p>\n                            <div class=\"formula mono\">\n                                d/dx ∫<sub>a</sub><sup>x</sup> f(t) dt = f(x)\n                            </div>\n                        </div>\n                        \n                        <div class=\"grid sm:grid-cols-3 gap-4\">\n                            <div class=\"p-4 rounded-lg text-center\" style=\"background: var(--bg-secondary);\">\n                                <div class=\"text-2xl font-bold\" style=\"color: var(--accent);\">链式法则</div>\n                                <p class=\"mono text-sm mt-2\" style=\"color: var(--muted);\">[f(g(x))]' = f'(g(x))·g'(x)</p>\n                            </div>\n                            <div class=\"p-4 rounded-lg text-center\" style=\"background: var(--bg-secondary);\">\n                                <div class=\"text-2xl font-bold\" style=\"color: var(--accent);\">乘积法则</div>\n                                <p class=\"mono text-sm mt-2\" style=\"color: var(--muted);\">[f·g]' = f'g + fg'</p>\n                            </div>\n                            <div class=\"p-4 rounded-lg text-center\" style=\"background: var(--bg-secondary);\">\n                                <div class=\"text-2xl font-bold\" style=\"color: var(--accent);\">商法则</div>\n                                <p class=\"mono text-sm mt-2\" style=\"color: var(--muted);\">[f/g]' = (f'g - fg')/g²</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        \n        <!-- Demo Module -->\n        <section id=\"demo\" class=\"module\">\n            <div class=\"space-y-6\">\n                <div class=\"text-center space-y-2\">\n                    <h2 class=\"text-3xl font-bold\">图形演示</h2>\n                    <p style=\"color: var(--muted);\">拖动滑块调整参数，观察曲线变化</p>\n                </div>\n                \n                <div class=\"grid lg:grid-cols-3 gap-6\">\n                    <!-- Canvas Area -->\n                    <div class=\"lg:col-span-2 space-y-4\">\n                        <div class=\"canvas-container\">\n                            <canvas id=\"mainCanvas\" width=\"700\" height=\"450\"></canvas>\n                        </div>\n                        <div class=\"flex flex-wrap gap-2\">\n                            <button class=\"control-btn\" onclick=\"setDemo('derivative')\">导数演示</button>\n                            <button class=\"control-btn\" onclick=\"setDemo('integral')\">积分演示</button>\n                            <button class=\"control-btn\" onclick=\"setDemo('tangent')\">切线可视化</button>\n                            <button class=\"control-btn\" onclick=\"setDemo('riemann')\">黎曼和</button>\n                        </div>\n                    </div>\n                    \n                    <!-- Controls -->\n                    <div class=\"card space-y-6\">\n                        <div>\n                            <h3 class=\"font-bold mb-4\">函数选择</h3>\n                            <select id=\"functionSelect\" class=\"w-full p-3 rounded-lg\" style=\"background: var(--bg-secondary); border: 1px solid var(--border); color: var(--fg);\" onchange=\"updateDemo()\">\n                                <option value=\"quadratic\">f(x) = x²</option>\n                                <option value=\"sine\">f(x) = sin(x)</option>\n                                <option value=\"cubic\">f(x) = x³ - x</option>\n                                <option value=\"exp\">f(x) = e^x</option>\n                            </select>\n                        </div>\n                        \n                        <div>\n                            <label class=\"block mb-2 font-medium\">观察点位置</label>\n                            <input type=\"range\" id=\"pointSlider\" class=\"slider\" min=\"-2\" max=\"2\" step=\"0.05\" value=\"0\" oninput=\"updateDemo()\">\n                            <div class=\"flex justify-between text-sm mt-1\" style=\"color: var(--muted);\">\n                                <span>-2</span>\n                                <span id=\"pointValue\" class=\"mono\" style=\"color: var(--accent);\">0.00</span>\n                                <span>2</span>\n                            </div>\n                        </div>\n                        \n                        <div id=\"integralControls\" style=\"display: none;\">\n                            <label class=\"block mb-2 font-medium\">积分上限</label>\n                            <input type=\"range\" id=\"integralSlider\" class=\"slider\" min=\"-2\" max=\"2\" step=\"0.05\" value=\"1\" oninput=\"updateDemo()\">\n                            <div class=\"flex justify-between text-sm mt-1\" style=\"color: var(--muted);\">\n                                <span>-2</span>\n                                <span id=\"integralValue\" class=\"mono\" style=\"color: var(--accent-secondary);\">1.00</span>\n                                <span>2</span>\n                            </div>\n                        </div>\n                        \n                        <div id=\"riemannControls\" style=\"display: none;\">\n                            <label class=\"block mb-2 font-medium\">矩形数量</label>\n                            <input type=\"range\" id=\"riemannSlider\" class=\"slider\" min=\"4\" max=\"50\" step=\"1\" value=\"10\" oninput=\"updateDemo()\">\n                            <div class=\"text-center text-sm mt-1 mono\" style=\"color: var(--accent);\">\n                                <span id=\"riemannValue\">10</span> 个矩形\n                            </div>\n                        </div>\n                        \n                        <div class=\"p-4 rounded-lg\" style=\"background: var(--bg-secondary);\">\n                            <h4 class=\"font-bold mb-2\">计算结果</h4>\n                            <div id=\"resultDisplay\" class=\"space-y-2 mono text-sm\">\n                                <div>f(x) = <span style=\"color: var(--accent);\">x²</span></div>\n                                <div>f'(x) = <span style=\"color: var(--accent-secondary);\">2x</span></div>\n                                <div>在 x = 0: <span style=\"color: var(--fg);\">f'(0) = 0</span></div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        \n        <!-- Exercise Module -->\n        <section id=\"exercise\" class=\"module\">\n            <div class=\"space-y-6\">\n                <div class=\"text-center space-y-2\">\n                    <h2 class=\"text-3xl font-bold\">练习测试</h2>\n                    <p style=\"color: var(--muted);\">检验你的微积分知识</p>\n                </div>\n                \n                <!-- Progress -->\n                <div class=\"card\">\n                    <div class=\"flex justify-between items-center mb-2\">\n                        <span class=\"font-medium\">进度</span>\n                        <span id=\"progressText\" class=\"mono\" style=\"color: var(--accent);\">0 / 5</span>\n                    </div>\n                    <div class=\"progress-bar\">\n                        <div id=\"progressFill\" class=\"progress-fill\" style=\"width: 0%;\"></div>\n                    </div>\n                </div>\n                \n                <!-- Quiz Area -->\n                <div class=\"card\">\n                    <div id=\"quizArea\">\n                        <div class=\"flex items-center gap-3 mb-6\">\n                            <div class=\"w-8 h-8 rounded-full flex items-center justify-center mono font-bold\" style=\"background: var(--accent); color: var(--bg);\">\n                                <span id=\"questionNum\">1</span>\n                            </div>\n                            <h3 id=\"questionText\" class=\"text-xl font-bold\">函数 f(x) = x² 的导数是?</h3>\n                        </div>\n                        \n                        <div id=\"optionsContainer\" class=\"space-y-3\">\n                            <!-- Options will be populated by JS -->\n                        </div>\n                        \n                        <div id=\"feedback\" class=\"mt-6 p-4 rounded-lg hidden\" style=\"background: var(--bg-secondary);\">\n                            <p id=\"feedbackText\"></p>\n                        </div>\n                        \n                        <div class=\"flex justify-end mt-6\">\n                            <button id=\"nextBtn\" class=\"control-btn hidden\" onclick=\"nextQuestion()\">下一题</button>\n                        </div>\n                    </div>\n                    \n                    <!-- Results -->\n                    <div id=\"resultsArea\" class=\"hidden text-center space-y-6\">\n                        <div class=\"text-6xl font-bold\" style=\"color: var(--accent);\" id=\"scoreDisplay\">0%</div>\n                        <p id=\"scoreMessage\" style=\"color: var(--muted);\">继续努力!</p>\n                        <button class=\"control-btn\" onclick=\"restartQuiz()\">重新开始</button>\n                    </div>\n                </div>\n            </div>\n        </section>\n        \n    </main>\n    \n    <!-- Footer -->\n    <footer class=\"text-center py-8\" style=\"color: var(--muted);\">\n        <p>微积分演示 - 交互式学习工具</p>\n    </footer>\n\n    <script>\n        // Initialize variables first\n        let currentDemo = 'derivative';\n        let currentQuestion = 0;\n        let score = 0;\n        let answered = false;\n        \n        // Quiz Data\n        const quizData = [\n            {\n                question: \"函数 f(x) = x² 的导数是?\",\n                options: [\"f'(x) = x\", \"f'(x) = 2x\", \"f'(x) = x²\", \"f'(x) = 2x²\"],\n                correct: 1,\n                explanation: \"根据幂函数求导法则，(xⁿ)' = n·xⁿ⁻¹，所以 (x²)' = 2x\"\n            },\n            {\n                question: \"∫x dx 等于?\",\n                options: [\"x²\", \"x²/2\", \"x\", \"1\"],\n                correct: 1,\n                explanation: \"根据幂函数积分公式，∫xⁿdx = xⁿ⁺¹/(n+1) + C，所以 ∫x dx = x²/2 + C\"\n            },\n            {\n                question: \"函数 f(x) = sin(x) 的导数是?\",\n                options: [\"cos(x)\", \"-sin(x)\", \"-cos(x)\", \"sin(x)\"],\n                correct: 0,\n                explanation: \"三角函数的导数：(sin x)' = cos x，(cos x)' = -sin x\"\n            },\n            {\n                question: \"微积分基本定理建立了什么之间的关系?\",\n                options: [\"极限与连续\", \"导数与积分\", \"微分与极限\", \"积分与级数\"],\n                correct: 1,\n                explanation: \"微积分基本定理建立了导数与积分之间的桥梁，表明它们互为逆运算\"\n            },\n            {\n                question: \"如果 f'(x₀) = 0，则 x₀ 可能是什么点?\",\n                options: [\"断点\", \"极值点\", \"零点\", \"拐点\"],\n                correct: 1,\n                explanation: \"导数为零的点可能是极值点（极大值或极小值），这是费马定理的内容\"\n            }\n        ];\n        \n        // Function definitions\n        const functions = {\n            quadratic: { f: x => x * x, df: x => 2 * x, name: 'x²', dname: '2x' },\n            sine: { f: x => Math.sin(x * 2), df: x => 2 * Math.cos(x * 2), name: 'sin(x)', dname: 'cos(x)' },\n            cubic: { f: x => x * x * x - x, df: x => 3 * x * x - 1, name: 'x³ - x', dname: '3x² - 1' },\n            exp: { f: x => Math.exp(x) - 1, df: x => Math.exp(x), name: 'e^x - 1', dname: 'e^x' }\n        };\n        \n        // Particle system\n        function createParticles() {\n            const container = document.getElementById('particles');\n            if (!container) return;\n            container.innerHTML = '';\n            for (let i = 0; i < 20; i++) {\n                const particle = document.createElement('div');\n                particle.className = 'floating-particle';\n                particle.style.left = Math.random() * 100 + '%';\n                particle.style.top = Math.random() * 100 + '%';\n                particle.style.animationDelay = Math.random() * 8 + 's';\n                particle.style.animationDuration = (6 + Math.random() * 4) + 's';\n                container.appendChild(particle);\n            }\n        }\n        \n        // Module switching\n        function switchModule(targetId) {\n            const modules = document.querySelectorAll('.module');\n            modules.forEach(m => m.classList.remove('active'));\n            \n            const targetModule = document.getElementById(targetId);\n            if (targetModule) {\n                targetModule.classList.add('active');\n            }\n            \n            const buttons = document.querySelectorAll('.nav-btn');\n            buttons.forEach(btn => {\n                btn.classList.remove('active');\n                if (btn.getAttribute('data-target') === targetId) {\n                    btn.classList.add('active');\n                }\n            });\n            \n            if (targetId === 'demo') {\n                setTimeout(initCanvas, 100);\n            }\n        }\n        \n        // Canvas initialization\n        function initCanvas() {\n            const canvas = document.getElementById('mainCanvas');\n            if (!canvas) return;\n            \n            const ctx = canvas.getContext('2d');\n            if (!ctx) return;\n            \n            // Responsive canvas\n            const container = canvas.parentElement;\n            const rect = container.getBoundingClientRect();\n            canvas.width = Math.max(400, rect.width);\n            canvas.height = 450;\n            \n            updateDemo();\n        }\n        \n        // Set demo type\n        function setDemo(type) {\n            currentDemo = type;\n            \n            const integralControls = document.getElementById('integralControls');\n            const riemannControls = document.getElementById('riemannControls');\n            \n            if (integralControls) integralControls.style.display = 'none';\n            if (riemannControls) riemannControls.style.display = 'none';\n            \n            if (type === 'integral' && integralControls) {\n                integralControls.style.display = 'block';\n            } else if (type === 'riemann' && riemannControls) {\n                riemannControls.style.display = 'block';\n            }\n            \n            updateDemo();\n        }\n        \n        // Update demo visualization\n        function updateDemo() {\n            const canvas = document.getElementById('mainCanvas');\n            if (!canvas) return;\n            \n            const ctx = canvas.getContext('2d');\n            if (!ctx) return;\n            \n            const width = canvas.width;\n            const height = canvas.height;\n            \n            // Clear canvas\n            ctx.fillStyle = '#111827';\n            ctx.fillRect(0, 0, width, height);\n            \n            // Get current values\n            const funcSelect = document.getElementById('functionSelect');\n            const pointSlider = document.getElementById('pointSlider');\n            const integralSlider = document.getElementById('integralSlider');\n            const riemannSlider = document.getElementById('riemannSlider');\n            \n            const funcKey = funcSelect ? funcSelect.value : 'quadratic';\n            const x0 = pointSlider ? parseFloat(pointSlider.value) : 0;\n            const x1 = integralSlider ? parseFloat(integralSlider.value) : 1;\n            const n = riemannSlider ? parseInt(riemannSlider.value) : 10;\n            \n            // Update displays\n            const pointValue = document.getElementById('pointValue');\n            const integralValue = document.getElementById('integralValue');\n            const riemannValue = document.getElementById('riemannValue');\n            \n            if (pointValue) pointValue.textContent = x0.toFixed(2);\n            if (integralValue) integralValue.textContent = x1.toFixed(2);\n            if (riemannValue) riemannValue.textContent = n;\n            \n            const func = functions[funcKey];\n            \n            // Coordinate system\n            const cx = width / 2;\n            const cy = height / 2;\n            const scale = 80;\n            \n            // Draw grid\n            ctx.strokeStyle = '#2a3548';\n            ctx.lineWidth = 1;\n            for (let i = -5; i <= 5; i++) {\n                ctx.beginPath();\n                ctx.moveTo(cx + i * scale, 0);\n                ctx.lineTo(cx + i * scale, height);\n                ctx.stroke();\n                ctx.beginPath();\n                ctx.moveTo(0, cy + i * scale);\n                ctx.lineTo(width, cy + i * scale);\n                ctx.stroke();\n            }\n            \n            // Draw axes\n            ctx.strokeStyle = '#6b7994';\n            ctx.lineWidth = 2;\n            ctx.beginPath();\n            ctx.moveTo(0, cy);\n            ctx.lineTo(width, cy);\n            ctx.moveTo(cx, 0);\n            ctx.lineTo(cx, height);\n            ctx.stroke();\n            \n            // Draw function curve\n            ctx.strokeStyle = '#00d4aa';\n            ctx.lineWidth = 3;\n            ctx.beginPath();\n            let started = false;\n            for (let px = 0; px < width; px++) {\n                const x = (px - cx) / scale;\n                const y = func.f(x);\n                const py = cy - y * scale;\n                if (py > -100 && py < height + 100) {\n                    if (!started) {\n                        ctx.moveTo(px, py);\n                        started = true;\n                    } else {\n                        ctx.lineTo(px, py);\n                    }\n                }\n            }\n            ctx.stroke();\n            \n            // Demo specific visualizations\n            if (currentDemo === 'derivative' || currentDemo === 'tangent') {\n                // Draw tangent line\n                const slope = func.df(x0);\n                const y0 = func.f(x0);\n                \n                ctx.strokeStyle = '#ff6b6b';\n                ctx.lineWidth = 2;\n                ctx.setLineDash([5, 5]);\n                ctx.beginPath();\n                const xStart = x0 - 3;\n                const xEnd = x0 + 3;\n                ctx.moveTo(cx + xStart * scale, cy - (y0 + slope * (xStart - x0)) * scale);\n                ctx.lineTo(cx + xEnd * scale, cy - (y0 + slope * (xEnd - x0)) * scale);\n                ctx.stroke();\n                ctx.setLineDash([]);\n                \n                // Draw point\n                ctx.fillStyle = '#ff6b6b';\n                ctx.beginPath();\n                ctx.arc(cx + x0 * scale, cy - y0 * scale, 8, 0, Math.PI * 2);\n                ctx.fill();\n                \n                // Update result\n                updateResult(func.name, func.dname, x0, slope);\n            }\n            \n            if (currentDemo === 'integral') {\n                // Draw integral area\n                ctx.fillStyle = 'rgba(255, 107, 107, 0.3)';\n                ctx.beginPath();\n                ctx.moveTo(cx, cy);\n                for (let x = 0; x <= x1; x += 0.02) {\n                    const y = func.f(x);\n                    ctx.lineTo(cx + x * scale, cy - y * scale);\n                }\n                ctx.lineTo(cx + x1 * scale, cy);\n                ctx.closePath();\n                ctx.fill();\n                \n                // Calculate integral (approximate)\n                let integral = 0;\n                const steps = 1000;\n                const dx = x1 / steps;\n                for (let i = 0; i < steps; i++) {\n                    integral += func.f(i * dx) * dx;\n                }\n                \n                updateResultIntegral(func.name, x1, integral);\n            }\n            \n            if (currentDemo === 'riemann') {\n                // Draw Riemann rectangles\n                const a = 0;\n                const b = x1;\n                const dx = (b - a) / n;\n                \n                for (let i = 0; i < n; i++) {\n                    const x = a + i * dx;\n                    const y = func.f(x + dx / 2); // midpoint\n                    const rectHeight = Math.abs(y) * scale;\n                    \n                    ctx.fillStyle = i % 2 === 0 ? 'rgba(0, 212, 170, 0.4)' : 'rgba(255, 107, 107, 0.4)';\n                    ctx.fillRect(\n                        cx + x * scale,\n                        cy - Math.max(0, y) * scale,\n                        dx * scale,\n                        rectHeight\n                    );\n                    ctx.strokeStyle = '#00d4aa';\n                    ctx.lineWidth = 1;\n                    ctx.strokeRect(\n                        cx + x * scale,\n                        cy - Math.max(0, y) * scale,\n                        dx * scale,\n                        rectHeight\n                    );\n                }\n                \n                // Calculate Riemann sum\n                let sum = 0;\n                for (let i = 0; i < n; i++) {\n                    const x = a + i * dx + dx / 2;\n                    sum += func.f(x) * dx;\n                }\n                \n                updateResultRiemann(n, sum);\n            }\n        }\n        \n        // Update result displays\n        function updateResult(fname, dfname, x, slope) {\n            const display = document.getElementById('resultDisplay');\n            if (!display) return;\n            display.innerHTML = `\n                <div>f(x) = <span style=\"color: var(--accent);\">${fname}</span></div>\n                <div>f'(x) = <span style=\"color: var(--accent-secondary);\">${dfname}</span></div>\n                <div>在 x = ${x.toFixed(2)}: <span style=\"color: var(--fg);\">f'(${x.toFixed(2)}) = ${slope.toFixed(3)}</span></div>\n            `;\n        }\n        \n        function updateResultIntegral(fname, x1, integral) {\n            const display = document.getElementById('resultDisplay');\n            if (!display) return;\n            display.innerHTML = `\n                <div>f(x) = <span style=\"color: var(--accent);\">${fname}</span></div>\n                <div>∫₀^${x1.toFixed(2)} f(x) dx ≈ <span style=\"color: var(--accent-secondary);\">${integral.toFixed(4)}</span></div>\n            `;\n        }\n        \n        function updateResultRiemann(n, sum) {\n            const display = document.getElementById('resultDisplay');\n            if (!display) return;\n            display.innerHTML = `\n                <div>矩形数量: <span style=\"color: var(--accent);\">${n}</span></div>\n                <div>黎曼和 ≈ <span style=\"color: var(--accent-secondary);\">${sum.toFixed(4)}</span></div>\n            `;\n        }\n        \n        // Quiz functions\n        function loadQuestion() {\n            const quizArea = document.getElementById('quizArea');\n            const resultsArea = document.getElementById('resultsArea');\n            \n            if (currentQuestion >= quizData.length) {\n                showResults();\n                return;\n            }\n            \n            if (quizArea) quizArea.classList.remove('hidden');\n            if (resultsArea) resultsArea.classList.add('hidden');\n            \n            const q = quizData[currentQuestion];\n            const questionNum = document.getElementById('questionNum');\n            const questionText = document.getElementById('questionText');\n            const optionsContainer = document.getElementById('optionsContainer');\n            const feedback = document.getElementById('feedback');\n            const nextBtn = document.getElementById('nextBtn');\n            \n            if (questionNum) questionNum.textContent = currentQuestion + 1;\n            if (questionText) questionText.textContent = q.question;\n            if (feedback) feedback.classList.add('hidden');\n            if (nextBtn) nextBtn.classList.add('hidden');\n            \n            answered = false;\n            \n            if (optionsContainer) {\n                optionsContainer.innerHTML = '';\n                q.options.forEach((opt, i) => {\n                    const btn = document.createElement('button');\n                    btn.className = 'quiz-option';\n                    btn.textContent = opt;\n                    btn.onclick = () => selectAnswer(i);\n                    optionsContainer.appendChild(btn);\n                });\n            }\n            \n            updateProgress();\n        }\n        \n        function selectAnswer(index) {\n            if (answered) return;\n            answered = true;\n            \n            const q = quizData[currentQuestion];\n            const options = document.querySelectorAll('.quiz-option');\n            const feedback = document.getElementById('feedback');\n            const feedbackText = document.getElementById('feedbackText');\n            const nextBtn = document.getElementById('nextBtn');\n            \n            options.forEach((opt, i) => {\n                opt.style.pointerEvents = 'none';\n                if (i === q.correct) {\n                    opt.classList.add('correct');\n                } else if (i === index && index !== q.correct) {\n                    opt.classList.add('incorrect');\n                }\n            });\n            \n            if (feedback && feedbackText) {\n                feedback.classList.remove('hidden');\n                if (index === q.correct) {\n                    score++;\n                    feedbackText.innerHTML = `<span style=\"color: var(--accent);\">正确!</span> ${q.explanation}`;\n                } else {\n                    feedbackText.innerHTML = `<span style=\"color: var(--accent-secondary);\">错误!</span> ${q.explanation}`;\n                }\n            }\n            \n            if (nextBtn) nextBtn.classList.remove('hidden');\n        }\n        \n        function nextQuestion() {\n            currentQuestion++;\n            loadQuestion();\n        }\n        \n        function updateProgress() {\n            const progressText = document.getElementById('progressText');\n            const progressFill = document.getElementById('progressFill');\n            \n            if (progressText) progressText.textContent = `${currentQuestion} / ${quizData.length}`;\n            if (progressFill) progressFill.style.width = `${(currentQuestion / quizData.length) * 100}%`;\n        }",
