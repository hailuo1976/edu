      "content": "\n            <h2>🎨 图形演示</h2>\n            \n            <div class=\"demo-container\">\n                <div class=\"demo-card\">\n                    <h3>同分母分数加法</h3>\n                    <div class=\"fraction-display\">\n                        <div><span class=\"fraction\"><span class=\"fraction-top\">1</span><span class=\"fraction-bottom\">4</span></span> + <span class=\"fraction\"><span class=\"fraction-top\">2</span><span class=\"fraction-bottom\">4</span></span> = <span class=\"fraction\"><span class=\"fraction-top\">3</span><span class=\"fraction-bottom\">4</span></span>"
