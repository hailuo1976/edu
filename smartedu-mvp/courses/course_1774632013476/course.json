  "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>分数的加减法</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n        \n        body {\n            font-family: 'Microsoft YaHei', Arial, sans-serif;\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n            min-height: 100vh;\n            padding: 20px;\n        }\n        \n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n        \n        h1 {\n            text-align: center;\n            color: white;\n            font-size: 2.5em;\n            margin-bottom: 30px;\n            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);\n            animation: fadeInDown 1s ease;\n        }\n        \n        .section {\n            background: white;\n            border-radius: 20px;\n            padding: 30px;\n            margin-bottom: 30px;\n            box-shadow: 0 10px 30px rgba(0,0,0,0.2);\n            animation: fadeIn 1s ease;\n        }\n        \n        h2 {\n            color: #5a67d8;\n            font-size: 1.8em;\n            margin-bottom: 20px;\n            padding-bottom: 10px;\n            border-bottom: 3px solid #667eea;\n        }\n        \n        /* 概念模块 */\n        #concept .concept-box {\n            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);\n            padding: 20px;\n            border-radius: 15px;\n            margin: 15px 0;\n        }\n        \n        #concept h3 {\n            color: #4c51bf;\n            margin-bottom: 10px;\n        }\n        \n        #concept ul {\n            list-style: none;\n            padding-left: 20px;\n        }\n        \n        #concept li {\n            padding: 10px 0;\n            border-left: 4px solid #667eea;\n            padding-left: 15px;\n            margin: 10px 0;\n            background: white;\n            border-radius: 0 10px 10px 0;\n        }\n        \n        /* 演示模块 */\n        #demo .demo-container {\n            display: flex;\n            gap: 20px;\n            flex-wrap: wrap;\n            justify-content: center;\n        }\n        \n        .demo-card {\n            background: linear-gradient(135deg, #84fab0 0%, #8fd3f4 100%);\n            padding: 20px;\n            border-radius: 15px;\n            min-width: 280px;\n            text-align: center;\n        }\n        \n        .fraction-display {\n            font-size: 2em;\n            font-weight: bold;\n            color: #2d3748;\n            margin: 20px 0;\n        }\n        \n        .fraction-line {\n            width: 60px;\n            height: 4px;\n            background: #2d3748;\n            margin: 5px auto;\n        }\n        \n        .demo-steps {\n            text-align: left;\n            margin-top: 20px;\n        }\n        \n        .step-item {\n            background: rgba(255,255,255,0.8);\n            padding: 10px;\n            margin: 10px 0;\n            border-radius: 8px;\n            font-size: 0.95em;\n        }\n        \n        /* 练习模块 */\n        #exercise .exercise-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n            gap: 20px;\n        }\n        \n        .exercise-item {\n            background: #f7fafc;\n            padding: 20px;\n            border-radius: 15px;\n            border: 2px solid #e2e8f0;\n            transition: all 0.3s ease;\n        }\n        \n        .exercise-item:hover {\n            transform: translateY(-5px);\n            box-shadow: 0 5px 15px rgba(0,0,0,0.1);\n        }\n        \n        .question {\n            font-size: 1.2em;\n            margin-bottom: 15px;\n            color: #2d3748;\n        }\n        \n        .answer-box {\n            display: flex;\n            gap: 10px;\n            margin-bottom: 10px;\n        }\n        \n        .answer-input {\n            flex: 1;\n            padding: 10px;\n            font-size: 1.1em;\n            border: 2px solid #cbd5e0;\n            border-radius: 8px;\n            text-align: center;\n        }\n        \n        .answer-input:focus {\n            outline: none;\n            border-color: #667eea;\n        }\n        \n        .btn {\n            padding: 10px 20px;\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n            color: white;\n            border: none;\n            border-radius: 8px;\n            font-size: 1em;\n            cursor: pointer;\n            transition: all 0.3s ease;\n        }\n        \n        .btn:hover {\n            transform: scale(1.05);\n            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);\n        }\n        \n        .feedback {\n            margin-top: 10px;\n            padding: 10px;\n            border-radius: 8px;\n            font-weight: bold;\n            display: none;\n        }\n        \n        .correct {\n            background: #c6f6d5;\n            color: #22543d;\n            display: block;\n        }\n        \n        .incorrect {\n            background: #fed7d7;\n            color: #742a2a;\n            display: block;\n        }\n        \n        /* 动画 */\n        @keyframes fadeIn {\n            from { opacity: 0; transform: translateY(20px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n        \n        @keyframes fadeInDown {\n            from { opacity: 0; transform: translateY(-20px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n        \n        /* 分数显示 */\n        .fraction {\n            display: inline-flex;\n            flex-direction: column;\n            align-items: center;\n            vertical-align: middle;\n            margin: 0 5px;\n        }\n        \n        .fraction-top {\n            border-bottom: 2px solid currentColor;\n            padding: 2px 5px;\n        }\n        \n        .fraction-bottom {\n            padding: 2px 5px;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <h1>✨ 分数的加减法 ✨</h1>\n        \n        <!-- 概念讲解模块 -->\n        <div id=\"concept\" class=\"section\">\n            <h2>📖 概念讲解</h2>\n            \n            <div class=\"concept-box\">\n                <h3>什么是分数加减法？</h3>\n                <p>分数加减法是指对两个或多个分数进行加法或减法运算。分数加减法分为两种情况：同分母分数加减法和异分母分数加减法。</p>\n            </div>\n            \n            <div class=\"concept-box\">\n                <h3>同分母分数加减法</h3>\n                <ul>\n                    <li><strong>法则：</strong>分母不变，分子相加减</li>\n                    <li><strong>示例：</strong><span class=\"fraction\"><span class=\"fraction-top\">1</span><span class=\"fraction-bottom\">3</span></span> + <span class=\"fraction\"><span class=\"fraction-top\">1</span><span class=\"fraction-bottom\">3</span></span> = <span class=\"fraction\"><span class=\"fraction-top\">2</span><span class=\"fraction-bottom\">3</span></span></li>\n                    <li><strong>理解：</strong>就像把两块相同大小的蛋糕拼在一起，份数不变，块数增加</li>\n                </ul>\n            </div>\n            \n            <div class=\"concept-box\">\n                <h3>异分母分数加减法</h3>\n                <ul>\n                    <li><strong>第一步：</strong>找到公分母（通分）</li>\n                    <li><strong>第二步：</strong>把各分数化成同分母分数</li>\n                    <li><strong>第三步：</strong>按照同分母分数加减法计算</li>\n                    <li><strong>第四步：</strong>约分化简（如果需要）</li>\n                </ul>\n            </div>\n        </div>\n        \n        <!-- 图形演示模块 -->\n        <div id=\"demo\" class=\"section\">\n            <h2>🎨 图形演示</h2>\n            \n            <div class=\"demo-container\">\n                <div class=\"demo-card\">\n                    <h3>同分母分数加法</h3>\n                    <div class=\"fraction-display\">\n                        <div><span class=\"fraction\"><span class=\"fraction-top\">1</span><span class=\"fraction-bottom\">4</span></span> + <span class=\"fraction\"><span class=\"fraction-top\">2</span><span class=\"fraction-bottom\">4</span></span> = <span class=\"fraction\"><span class=\"fraction-top\">3</span><span class=\"fraction-bottom\">4</span></span></div>\n                    </div>\n                    <div class=\"demo-steps\">\n                        <div class=\"step-item\">✅ 分母相同，都是4</div>\n                        <div class=\"step-item\">✅ 分子相加：1 + 2 = 3</div>\n                        <div class=\"step-item\">✅ 分母保持不变：4</div>\n                        <div class=\"step-item\">✅ 结果：<span class=\"fraction\"><span class=\"fraction-top\">3</span><span class=\"fraction-bottom\">4</span></span></div>\n                    </div>\n                </div>\n                \n                <div class=\"demo-card\">\n                    <h3>异分母分数加法</h3>\n                    <div class=\"fraction-display\">\n                        <div><span class=\"fraction\"><span class=\"fraction-top\">1</span><span class=\"fraction-bottom\">2</span></span> + <span class=\"fraction\"><span class=\"fraction-top\">1</span><span class=\"fraction-bottom\">3</span></span> = <span class=\"fraction\"><span class=\"fraction-top\">5</span><span class=\"fraction-bottom\">6</span></span></div>\n                    </div>\n                    <div class=\"demo-steps\">\n                        <div class=\"step-item\">① 找公分母：2和3的最小公倍数是6</div>\n                        <div class=\"step-item\">② 通分：<span class=\"fraction\"><span class=\"fraction-top\">1</span><span class=\"fraction-bottom\">2</span></span> = <span class=\"fraction\"><span class=\"fraction-top\">3</span><span class=\"fraction-bottom\">6</span></span>，<span class=\"fraction\"><span class=\"fraction-top\">1</span><span class=\"fraction-bottom\">3</span></span> = <span class=\"fraction\"><span class=\"fraction-top\">2</span><span class=\"fraction-bottom\">6</span></span></div>\n                        <div class=\"step-item\">③ 相加：<span class=\"fraction\"><span class=\"fraction-top\">3</span><span class=\"fraction-bottom\">6</span></span> + <span class=\"fraction\"><span class=\"fraction-top\">2</span><span class=\"fraction-bottom\">6</span></span> = <span class=\"fraction\"><span class=\"fraction-top\">5</span><span class=\"fraction-bottom\">6</span></span></div>\n                        <div class=\"step-item\">④ 结果：<span class=\"fraction\"><span class=\"fraction-top\">5</span><span class=\"fraction-bottom\">6</span></span>（已是最简）</div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        \n        <!-- 练习测试模块 -->\n        <div id=\"exercise\" class=\"section\">\n            <h2>✏️ 练习测试</h2>\n            \n            <div class=\"exercise-grid\">\n                <div class=\"exercise-item\">\n                    <div class=\"question\">第1题：<span class=\"fraction\"><span class=\"fraction-top\">2</span><span class=\"fraction-bottom\">5</span></span> + <span class=\"fraction\"><span class=\"fraction-top\">1</span><span class=\"fraction-bottom\">5</span></span> = ?</div>\n                    <div class=\"answer-box\">\n                        <input type=\"text\" class=\"answer-input\" id=\"ex1-num\" placeholder=\"分子\">\n                        <span style=\"align-self:center\">/</span>\n                        <input type=\"text\" class=\"answer-input\" id=\"ex1-den\" placeholder=\"分母\">\n                    </div>\n                    <button class=\"btn\" onclick=\"checkAnswer1()\">检查答案</button>\n                    <div class=\"feedback\" id=\"fb1\"></div>\n                </div>\n                \n                <div class=\"exercise-item\">\n                    <div class=\"question\">第2题：<span class=\"fraction\"><span class=\"fraction-top\">1</span><span class=\"fraction-bottom\">3</span></span> + <span class=\"fraction\"><span class=\"fraction-top\">1</span><span class=\"fraction-bottom\">6</span></span> = ?</div>\n                    <div class=\"answer-box\">\n                        <input type=\"text\" class=\"answer-input\" id=\"ex2-num\" placeholder=\"分子\">\n                        <span style=\"align-self:center\">/</span>\n                        <input type=\"text\" class=\"answer-input\" id=\"ex2-den\" placeholder=\"分母\">\n                    </div>\n                    <button class=\"btn\" onclick=\"checkAnswer2()\">检查答案</button>\n                    <div class=\"feedback\" id=\"fb2\"></div>\n                </div>\n                \n                <div class=\"exercise-item\">\n                    <div class=\"question\">第3题：<span class=\"fraction\"><span class=\"fraction-top\">3</span><span class=\"fraction-bottom\">4</span></span> - <span class=\"fraction\"><span class=\"fraction-top\">1</span><span class=\"fraction-bottom\">4</span></span> = ?</div>\n                    <div class=\"answer-box\">\n                        <input type=\"text\" class=\"answer-input\" id=\"ex3-num\" placeholder=\"分子\">\n                        <span style=\"align-self:center\">/</span>\n                        <input type=\"text\" class=\"answer-input\" id=\"ex3-den\" placeholder=\"分母\">\n                    </div>\n                    <button class=\"btn\" onclick=\"checkAnswer3()\">检查答案</button>\n                    <div class=\"feedback\" id=\"fb3\"></div>\n                </div>\n                \n                <div class=\"exercise-item\">\n                    <div class=\"question\">第4题：<span class=\"fraction\"><span class=\"fraction-top\">1</span><span class=\"fraction-bottom\">2</span></span> - <span class=\"fraction\"><span class=\"fraction-top\">1</span><span class=\"fraction-bottom\">4</span></span> = ?</div>\n                    <div class=\"answer-box\">\n                        <input type=\"text\" class=\"answer-input\" id=\"ex4-num\" placeholder=\"分子\">\n                        <span style=\"align-self:center\">/</span>\n                        <input type=\"text\" class=\"answer-input\" id=\"ex4-den\" placeholder=\"分母\">\n                    </div>\n                    <button class=\"btn\" onclick=\"checkAnswer4()\">检查答案</button>\n                    <div class=\"feedback\" id=\"fb4\"></div>\n                </div>\n            </div>\n            \n            <div style=\"text-align:center; margin-top: 30px;\">\n                <button class=\"btn\" style=\"font-size: 1.2em; padding: 15px 40px;\" onclick=\"showAllAnswers()\">查看所有答案</button>\n            </div>\n        </div>\n    </div>\n    \n    <script>\n        // 第1题：同分母加法\n        function checkAnswer1() {\n            const num = document.getElementById('ex1-num').value.trim();\n            const den = document.getElementById('ex1-den').value.trim();\n            const fb = document.getElementById('fb1');\n            \n            if (num === '3' && den === '5') {\n                fb.textContent = '✅ 正确！同分母分数相加，分母不变，分子相加。';\n                fb.className = 'feedback correct';\n            } else {\n                fb.textContent = '❌ 再想想！提示：分母都是5，分子是2+1=?';\n                fb.className = 'feedback incorrect';\n            }\n        }\n        \n        // 第2题：异分母加法\n        function checkAnswer2() {\n            const num = document.getElementById('ex2-num').value.trim();\n            const den = document.getElementById('ex2-den').value.trim();\n            const fb = document.getElementById('fb2');\n            \n            if (num === '1' && den === '2') {\n                fb.textContent = '✅ 正确！先通分：1/3=2/6，然后2/6+1/6=3/6，化简得1/2。';\n                fb.className = 'feedback correct';\n            } else if (num === '3' && den === '6') {\n                fb.textContent = '✅ 正确！答案是3/6，可以约分成1/2。';\n                fb.className = 'feedback correct';\n            } else {\n                fb.textContent = '❌ 提示：先找3和6的最小公倍数作为公分母。';\n                fb.className = 'feedback incorrect';\n            }\n        }\n        \n        // 第3题：同分母减法\n        function checkAnswer3() {\n            const num = document.getElementById('ex3-num').value.trim();\n            const den = document.getElementById('ex3-den').value.trim();\n            const fb = document.getElementById('fb3');\n            \n            if (num === '1' && den === '2') {\n                fb.textContent = '✅ 正确！3/4 - 1/4 = 2/4，约分后得1/2。';\n                fb.className = 'feedback correct';\n            } else if (num === '2' && den === '4') {\n                fb.textContent = '✅ 正确！答案是2/4，可以约分成1/2。';\n                fb.className = 'feedback correct';\n            } else {\n                fb.textContent = '❌ 提示：同分母分数相减，分母不变，分子相减。';\n                fb.className = 'feedback incorrect';\n            }\n        }\n        \n        // 第4题：异分母减法\n        function checkAnswer4() {\n            const num = document.getElementById('ex4-num').value.trim();\n            const den = document.getElementById('ex4-den').value.trim();\n            const fb = document.getElementById('fb4');\n            \n            if (num === '1' && den === '4') {\n                fb.textContent = '✅ 正确！1/2=2/4，然后2/4-1/4=1/4。';\n                fb.className = 'feedback correct';\n            } else {\n                fb.textContent = '❌ 提示：先通分，2和4的最小公倍数是4。';\n                fb.className = 'feedback incorrect';\n            }\n        }\n        \n        // 显示所有答案\n        function showAllAnswers() {\n            alert('答案：\\n\\n第1题：3/5\\n第2题：1/2\\n第3题：1/2\\n第4题：1/4');\n        }\n        \n        // 添加回车键提交功能\n        document.querySelectorAll('.answer-input').forEach(input => {\n            input.addEventListener('keypress', function(e) {\n                if (e.key === 'Enter') {\n                    this.closest('.exercise-item').querySelector('.btn').click();\n                }\n            });\n        });\n    </script>\n</body>\n</html>",
