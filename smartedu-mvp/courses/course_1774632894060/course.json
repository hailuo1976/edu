        "course_id": "grade1_math_shapes",
        "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>认识图形 - 小学一年级数学</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n        \n        body {\n            font-family: 'Microsoft YaHei', sans-serif;\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n            min-height: 100vh;\n            padding: 20px;\n        }\n        \n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n        \n        h1 {\n            text-align: center;\n            color: white;\n            font-size: 2.5em;\n            margin-bottom: 30px;\n            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);\n            animation: bounce 1s ease infinite;\n        }\n        \n        @keyframes bounce {\n            0%, 100% { transform: translateY(0); }\n            50% { transform: translateY(-10px); }\n        }\n        \n        .section {\n            background: white;\n            border-radius: 20px;\n            padding: 30px;\n            margin-bottom: 30px;\n            box-shadow: 0 10px 40px rgba(0,0,0,0.2);\n        }\n        \n        .section-title {\n            font-size: 1.8em;\n            color: #4f46e5;\n            margin-bottom: 20px;\n            display: flex;\n            align-items: center;\n            gap: 10px;\n        }\n        \n        /* 概念模块 */\n        #concept .shape-cards {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n            gap: 25px;\n        }\n        \n        .shape-card {\n            background: linear-gradient(145deg, #f8fafc, #e2e8f0);\n            border-radius: 15px;\n            padding: 25px;\n            text-align: center;\n            transition: all 0.3s ease;\n            border: 3px solid transparent;\n        }\n        \n        .shape-card:hover {\n            transform: translateY(-10px) scale(1.02);\n            box-shadow: 0 15px 30px rgba(0,0,0,0.15);\n        }\n        \n        .shape-card.circle { border-color: #ef4444; }\n        .shape-card.square { border-color: #3b82f6; }\n        .shape-card.triangle { border-color: #10b981; }\n        \n        .shape-card svg {\n            margin-bottom: 15px;\n        }\n        \n        .shape-name {\n            font-size: 1.5em;\n            font-weight: bold;\n            margin: 10px 0;\n        }\n        \n        .shape-card.circle .shape-name { color: #ef4444; }\n        .shape-card.square .shape-name { color: #3b82f6; }\n        .shape-card.triangle .shape-name { color: #10b981; }\n        \n        .shape-desc {\n            color: #64748b;\n            line-height: 1.6;\n        }\n        \n        /* 演示模块 */\n        #demo canvas {\n            border: 2px dashed #cbd5e1;\n            border-radius: 15px;\n            cursor: pointer;\n        }\n        \n        .demo-instructions {\n            background: linear-gradient(135deg, #fef3c7, #fde68a);\n            padding: 15px;\n            border-radius: 10px;\n            margin-top: 15px;\n            font-size: 1.1em;\n        }\n        \n        /* 练习模块 */\n        #exercise .questions {\n            display: flex;\n            flex-direction: column;\n            gap: 20px;\n        }\n        \n        .question-item {\n            background: linear-gradient(145deg, #f1f5f9, #e2e8f0);\n            padding: 20px;\n            border-radius: 15px;\n            border-left: 5px solid #4f46e5;\n        }\n        \n        .question-text {\n            font-size: 1.3em;\n            margin-bottom: 15px;\n            color: #1e293b;\n        }\n        \n        .options {\n            display: flex;\n            gap: 15px;\n            flex-wrap: wrap;\n        }\n        \n        .option-btn {\n            padding: 12px 30px;\n            font-size: 1.1em;\n            border: none;\n            border-radius: 25px;\n            cursor: pointer;\n            transition: all 0.3s ease;\n            background: linear-gradient(145deg, #6366f1, #4f46e5);\n            color: white;\n        }\n        \n        .option-btn:hover {\n            transform: scale(1.05);\n            box-shadow: 0 5px 15px rgba(99, 102, 241, 0.4);\n        }\n        \n        .option-btn.correct {\n            background: linear-gradient(145deg, #10b981, #059669) !important;\n            animation: pulse 0.5s ease;\n        }\n        \n        .option-btn.wrong {\n            background: linear-gradient(145deg, #ef4444, #dc2626) !important;\n            animation: shake 0.5s ease;\n        }\n        \n        @keyframes pulse {\n            0%, 100% { transform: scale(1); }\n            50% { transform: scale(1.1); }\n        }\n        \n        @keyframes shake {\n            0%, 100% { transform: translateX(0); }\n            25% { transform: translateX(-10px); }\n            75% { transform: translateX(10px); }\n        }\n        \n        .feedback {\n            margin-top: 15px;\n            padding: 10px 20px;\n            border-radius: 10px;\n            font-size: 1.2em;\n            font-weight: bold;\n            display: none;\n        }\n        \n        .feedback.show {\n            display: block;\n            animation: fadeIn 0.3s ease;\n        }\n        \n        .feedback.correct {\n            background: linear-gradient(145deg, #d1fae5, #a7f3d0);\n            color: #047857;\n        }\n        \n        .feedback.wrong {\n            background: linear-gradient(145deg, #fee2e2, #fecaca);\n            color: #b91c1c;\n        }\n        \n        @keyframes fadeIn {\n            from { opacity: 0; transform: translateY(-10px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n        \n        .score-board {\n            text-align: center;\n            padding: 20px;\n            background: linear-gradient(135deg, #c4b5fd, #a78bfa);\n            border-radius: 15px;\n            margin-top: 20px;\n        }\n        \n        .score-board h3 {\n            color: white;\n            font-size: 1.5em;\n        }\n        \n        .score {\n            font-size: 3em;\n            color: #fbbf24;\n            text-shadow: 2px 2px 4px rgba(0,0,0,0.2);\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <h1>🔷 认识图形 🔷</h1>\n        \n        <!-- 概念讲解模块 -->\n        <div id=\"concept\" class=\"section\">\n            <h2 class=\"section-title\">📖 学习概念</h2>\n            <div class=\"shape-cards\">\n                <div class=\"shape-card circle\">\n                    <svg width=\"100\" height=\"100\" xmlns=\"http://www.w3.org/2000/svg\">\n                        <circle cx=\"50\" cy=\"50\" r=\"45\" fill=\"#ef4444\" stroke=\"#dc2626\" stroke-width=\"3\"/>\n                    </svg>\n                    <div class=\"shape-name\">🔴 圆形</div>\n                    <div class=\"shape-desc\">\n                        圆圆的，没有角<br>\n                        像太阳 ☀️、车轮 🛞\n                    </div>\n                </div>\n                \n                <div class=\"shape-card square\">\n                    <svg width=\"100\" height=\"100\" xmlns=\"http://www.w3.org/2000/svg\">\n                        <rect x=\"5\" y=\"5\" width=\"90\" height=\"90\" fill=\"#3b82f6\" stroke=\"#2563eb\" stroke-width=\"3\" rx=\"5\"/>\n                    </svg>\n                    <div class=\"shape-name\">🟦 正方形</div>\n                    <div class=\"shape-desc\">\n                        四条边一样长<br>\n                        四个角都是直角<br>\n                        像手帕、饼干 🍪\n                    </div>\n                </div>\n                \n                <div class=\"shape-card triangle\">\n                    <svg width=\"100\" height=\"100\" xmlns=\"http://www.w3.org/2000/svg\">\n                        <polygon points=\"50,5 95,95 5,95\" fill=\"#10b981\" stroke=\"#059669\" stroke-width=\"3\"/>\n                    </svg>\n                    <div class=\"shape-name\">🔺 三角形</div>\n                    <div class=\"shape-desc\">\n                        三条边，三个角<br>\n                        像小旗子 🚩、三角尺\n                    </div>\n                </div>\n            </div>\n        </div>\n        \n        <!-- 图形演示模块 -->\n        <div id=\"demo\" class=\"section\">\n            <h2 class=\"section-title\">🎨 图形演示</h2>\n            <canvas id=\"shapeCanvas\" width=\"800\" height=\"400\"></canvas>\n            <div class=\"demo-instructions\">\n                👆 点击画布上的图形，听老师讲解！再点击可以画出新图形哦！\n            </div>\n        </div>\n        \n        <!-- 练习测试模块 -->\n        <div id=\"exercise\" class=\"section\">\n            <h2 class=\"section-title\">✏️ 小练习</h2>\n            <div class=\"questions\" id=\"questionsContainer\">\n                <!-- 题目将由JavaScript生成 -->\n            </div>\n            <div class=\"score-board\">\n                <h3>🏆 得分</h3>\n                <div class=\"score\" id=\"score\">0</div>\n            </div>\n        </div>\n    </div>\n    \n    <script>\n        // 演示模块 - Canvas绘图\n        const canvas = document.getElementById('shapeCanvas');\n        const ctx = canvas.getContext('2d');\n        let currentShapeIndex = 0;\n        const colors = ['#ef4444', '#3b82f6', '#10b981', '#f59e0b', '#8b5cf6'];\n        \n        function drawShapes() {\n            ctx.clearRect(0, 0, canvas.width, canvas.height);\n            \n            // 绘制圆形\n            ctx.beginPath();\n            ctx.arc(120, 120, 80, 0, Math.PI * 2);\n            ctx.fillStyle = '#ef4444';\n            ctx.fill();\n            ctx.strokeStyle = '#dc2626';\n            ctx.lineWidth = 3;\n            ctx.stroke();\n            ctx.fillStyle = 'white';\n            ctx.font = 'bold 24px Microsoft YaHei';\n            ctx.textAlign = 'center';\n            ctx.fillText('圆形', 120, 130);\n            ctx.fillText('r=80', 120, 160);\n            \n            // 绘制正方形\n            ctx.fillStyle = '#3b82f6';\n            ctx.fillRect(280, 40, 160, 160);\n            ctx.strokeStyle = '#2563eb';\n            ctx.lineWidth = 3;\n            ctx.strokeRect(280, 40, 160, 160);\n            ctx.fillStyle = 'white';\n            ctx.font = 'bold 24px Microsoft YaHei';\n            ctx.textAlign = 'center';\n            ctx.fillText('正方形', 360, 110);\n            ctx.fillText('边长=160', 360, 145);\n            \n            // 绘制三角形\n            ctx.beginPath();\n            ctx.moveTo(600, 40);\n            ctx.lineTo(700, 200);\n            ctx.lineTo(500, 200);\n            ctx.closePath();\n            ctx.fillStyle = '#10b981';\n            ctx.fill();\n            ctx.strokeStyle = '#059669';\n            ctx.lineWidth = 3;\n            ctx.stroke();\n            ctx.fillStyle = 'white';\n            ctx.font = 'bold 24px Microsoft YaHei';\n            ctx.textAlign = 'center';\n            ctx.fillText('三角形', 600, 140);\n            \n            // 绘制动态图形区域\n            ctx.fillStyle = '#f8fafc';\n            ctx.fillRect(50, 250, 700, 120);\n            ctx.strokeStyle = '#cbd5e1';\n            ctx.lineWidth = 2;\n            ctx.setLineDash([5, 5]);\n            ctx.strokeRect(50, 250, 700, 120);\n            ctx.setLineDash([]);\n            ctx.fillStyle = '#64748b';\n            ctx.font = '20px Microsoft YaHei';\n            ctx.textAlign = 'center';\n            ctx.fillText('👆 点击这里绘制随机图形', 400, 320);\n        }\n        \n        canvas.addEventListener('click', function(e) {\n            const rect = canvas.getBoundingClientRect();\n            const x = e.clientX - rect.left;\n            const y = e.clientY - rect.top;\n            \n            if (y > 250) {\n                // 在动态区域绘制随机图形\n                const shapeType = Math.floor(Math.random() * 3);\n                const color = colors[Math.floor(Math.random() * colors.length)];\n                const size = 30 + Math.random() * 40;\n                \n                ctx.fillStyle = color;\n                ctx.strokeStyle = color;\n                ctx.lineWidth = 2;\n                \n                if (shapeType === 0) {\n                    ctx.beginPath();\n                    ctx.arc(x, y, size, 0, Math.PI * 2);\n                    ctx.fill();\n                    ctx.stroke();\n                } else if (shapeType === 1) {\n                    ctx.fillRect(x - size, y - size, size * 2, size * 2);\n                    ctx.strokeRect(x - size, y - size, size * 2, size * 2);\n                } else {\n                    ctx.beginPath();\n                    ctx.moveTo(x, y - size);\n                    ctx.lineTo(x + size, y + size);\n                    ctx.lineTo(x - size, y + size);\n                    ctx.closePath();\n                    ctx.fill();\n                    ctx.stroke();\n                }\n            }\n        });\n        \n        drawShapes();\n        \n        // 练习模块\n        const questions = [\n            {\n                question: \"下面哪个是圆形？\",\n                options: [\"正方形\", \"圆形\", \"三角形\"],\n                answer: \"圆形\"\n            },\n            {\n                question: \"三角形有几个角？\",\n                options: [\"2个\", \"3个\", \"4个\"],\n                answer: \"3个\"\n            },\n            {\n                question: \"正方形有几条边？\",\n                options: [\"3条\", \"4条\", \"5条\"],\n                answer: \"4条\"\n            },\n            {\n                question: \"车轮是什么形状？\",\n                options: [\"正方形\", \"三角形\", \"圆形\"],\n                answer: \"圆形\"\n            },\n            {\n                question: \"红领巾是什么形状？\",\n                options: [\"圆形\", \"三角形\", \"正方形\"],\n                answer: \"三角形\"\n            }\n        ];\n        \n        let score = 0;\n        const container = document.getElementById('questionsContainer');\n        \n        questions.forEach((q, index) => {\n            const div = document.createElement('div');\n            div.className = 'question-item';\n            div.innerHTML = `\n                <div class=\"question-text\">${index + 1}. ${q.question}</div>\n                <div class=\"options\">\n                    ${q.options.map(opt => `\n                        <button class=\"option-btn\" data-answer=\"${opt}\" data-correct=\"${q.answer}\">\n                            ${opt}\n                        </button>\n                    `).join('')}\n                </div>\n                <div class=\"feedback\"></div>\n            `;\n            container.appendChild(div);\n        });\n        \n        // 点击选项处理\n        document.querySelectorAll('.option-btn').forEach(btn => {\n            btn.addEventListener('click', function() {\n                const answer = this.dataset.answer;\n                const correct = this.dataset.correct;\n                const feedback = this.parentElement.nextElementSibling;\n                const allBtns = this.parentElement.querySelectorAll('.option-btn');\n                \n                // 禁用所有按钮\n                allBtns.forEach(b => b.disabled = true);\n                \n                if (answer === correct) {\n                    this.classList.add('correct');\n                    feedback.className = 'feedback show correct';\n                    feedback.textContent = '✅ 太棒了！回答正确！';\n                    score += 20;\n                } else {\n                    this.classList.add('wrong');\n                    feedback.className = 'feedback show wrong';\n                    feedback.textContent = `❌ 再想想哦！正确答案是：${correct}`;\n                    // 高亮正确答案\n                    allBtns.forEach(b => {\n                        if (b.dataset.answer === correct) {\n                            b.classList.add('correct');\n                        }\n                    });\n                }\n                \n                document.getElementById('score').textContent = score;\n            });\n        });\n    </script>\n</body>\n</html>"
      },
