        "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>正方形面积 - 小学三年级数学</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n        \n        body {\n            font-family: 'Microsoft YaHei', Arial, sans-serif;\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n            min-height: 100vh;\n            padding: 20px;\n        }\n        \n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n        \n        header {\n            text-align: center;\n            color: white;\n            padding: 30px 0;\n            margin-bottom: 30px;\n        }\n        \n        header h1 {\n            font-size: 3em;\n            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);\n            margin-bottom: 10px;\n            animation: slideDown 0.8s ease-out;\n        }\n        \n        header p {\n            font-size: 1.2em;\n            opacity: 0.9;\n        }\n        \n        .module {\n            background: white;\n            border-radius: 20px;\n            padding: 30px;\n            margin-bottom: 30px;\n            box-shadow: 0 10px 40px rgba(0,0,0,0.2);\n            animation: fadeIn 1s ease-out;\n        }\n        \n        .module h2 {\n            color: #667eea;\n            font-size: 2em;\n            margin-bottom: 20px;\n            padding-bottom: 10px;\n            border-bottom: 3px solid #667eea;\n        }\n        \n        #concept {\n            animation-delay: 0.2s;\n        }\n        \n        #demo {\n            animation-delay: 0.4s;\n        }\n        \n        #exercise {\n            animation-delay: 0.6s;\n        }\n        \n        .formula-box {\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n            color: white;\n            padding: 30px;\n            border-radius: 15px;\n            font-size: 2em;\n            text-align: center;\n            margin: 20px 0;\n            box-shadow: 0 5px 20px rgba(102, 126, 234, 0.4);\n            transition: transform 0.3s ease;\n        }\n        \n        .formula-box:hover {\n            transform: scale(1.05);\n        }\n        \n        .concept-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n            gap: 20px;\n            margin-top: 20px;\n        }\n        \n        .concept-card {\n            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);\n            padding: 20px;\n            border-radius: 15px;\n            border-left: 5px solid #667eea;\n        }\n        \n        .concept-card h3 {\n            color: #667eea;\n            margin-bottom: 10px;\n        }\n        \n        .demo-container {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            flex-wrap: wrap;\n            gap: 30px;\n        }\n        \n        #demoCanvas {\n            border: 3px solid #667eea;\n            border-radius: 10px;\n            background: white;\n            box-shadow: 0 5px 20px rgba(0,0,0,0.1);\n        }\n        \n        .controls {\n            display: flex;\n            flex-direction: column;\n            gap: 15px;\n            min-width: 250px;\n        }\n        \n        .control-group {\n            background: #f5f7fa;\n            padding: 15px;\n            border-radius: 10px;\n        }\n        \n        .control-group label {\n            display: block;\n            margin-bottom: 10px;\n            font-weight: bold;\n            color: #667eea;\n        }\n        \n        .control-group input[type=\"range\"] {\n            width: 100%;\n            height: 8px;\n            border-radius: 5px;\n            background: #ddd;\n            outline: none;\n            -webkit-appearance: none;\n        }\n        \n        .control-group input[type=\"range\"]::-webkit-slider-thumb {\n            -webkit-appearance: none;\n            width: 20px;\n            height: 20px;\n            border-radius: 50%;\n            background: #667eea;\n            cursor: pointer;\n        }\n        \n        .result-box {\n            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);\n            color: white;\n            padding: 20px;\n            border-radius: 10px;\n            font-size: 1.3em;\n            text-align: center;\n        }\n        \n        .exercise-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n            gap: 20px;\n        }\n        \n        .exercise-card {\n            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);\n            padding: 25px;\n            border-radius: 15px;\n            border: 3px solid transparent;\n            transition: all 0.3s ease;\n        }\n        \n        .exercise-card.correct {\n            border-color: #38ef7d;\n            background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%);\n        }\n        \n        .exercise-card.incorrect {\n            border-color: #e74c3c;\n            background: linear-gradient(135deg, #f8d7da 0%, #f5c6cb 100%);\n        }\n        \n        .exercise-card h3 {\n            color: #667eea;\n            margin-bottom: 15px;\n        }\n        \n        .exercise-card input[type=\"number\"] {\n            width: 100px;\n            padding: 10px;\n            font-size: 1.2em;\n            border: 2px solid #667eea;\n            border-radius: 8px;\n            text-align: center;\n            margin: 10px 0;\n        }\n        \n        .exercise-card button {\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n            color: white;\n            border: none;\n            padding: 12px 30px;\n            font-size: 1em;\n            border-radius: 25px;\n            cursor: pointer;\n            transition: all 0.3s ease;\n            margin-top: 10px;\n        }\n        \n        .exercise-card button:hover {\n            transform: translateY(-2px);\n            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);\n        }\n        \n        .feedback {\n            margin-top: 15px;\n            padding: 10px;\n            border-radius: 8px;\n            font-weight: bold;\n            display: none;\n        }\n        \n        .feedback.show {\n            display: block;\n            animation: fadeIn 0.3s ease-out;\n        }\n        \n        .feedback.correct {\n            background: #38ef7d;\n            color: white;\n        }\n        \n        .feedback.incorrect {\n            background: #e74c3c;\n            color: white;\n        }\n        \n        .hint {\n            background: #fff3cd;\n            padding: 10px;\n            border-radius: 8px;\n            margin-top: 10px;\n            font-size: 0.9em;\n        }\n        \n        @keyframes fadeIn {\n            from {\n                opacity: 0;\n                transform: translateY(20px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n        \n        @keyframes slideDown {\n            from {\n                opacity: 0;\n                transform: translateY(-30px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n        \n        .example-box {\n            background: #e8f4f8;\n            padding: 20px;\n            border-radius: 10px;\n            margin: 15px 0;\n            border-left: 5px solid #3498db;\n        }\n        \n        .example-box h4 {\n            color: #3498db;\n            margin-bottom: 10px;\n        }\n        \n        .step {\n            margin: 10px 0;\n            padding: 10px;\n            background: white;\n            border-radius: 8px;\n        }\n        \n        footer {\n            text-align: center;\n            color: white;\n            padding: 20px;\n            margin-top: 30px;\n            opacity: 0.8;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <header>\n            <h1>📐 正方形面积</h1>\n            <p>小学三年级数学 | 认识图形的面积</p>\n        </header>\n        \n        <!-- 概念讲解模块 -->\n        <div id=\"concept\" class=\"module\">\n            <h2>📚 概念讲解</h2>\n            \n            <div class=\"formula-box\">\n                <div>正方形面积公式</div>\n                <div style=\"font-size: 1.5em; margin-top: 15px;\">S = a × a = a²</div>\n                <div style=\"font-size: 0.6em; margin-top: 15px;\">其中 S 表示面积，a 表示边长</div>\n            </div>\n            \n            <div class=\"concept-grid\">\n                <div class=\"concept-card\">\n                    <h3>🎯 什么是正方形？</h3>\n                    <p>正方形是一种特殊的四边形，它有<strong>四条相等的边</strong>和<strong>四个直角</strong>。</p>\n                </div>\n                \n                <div class=\"concept-card\">\n                    <h3>📏 什么是面积？</h3>\n                    <p>面积是物体表面或平面图形的<strong>大小</strong>。正方形的面积就是它所占据的平面大小。</p>\n                </div>\n                \n                <div class=\"concept-card\">\n                    <h3>🔢 面积单位</h3>\n                    <p>常用的面积单位有：<strong>平方厘米(cm²)</strong>、<strong>平方分米(dm²)</strong>、<strong>平方米(m²)</strong></p>\n                </div>\n            </div>\n            \n            <div class=\"example-box\">\n                <h4>💡 计算示例</h4>\n                <div class=\"step\">\n                    <strong>例题：</strong>一个正方形的边长是 5 厘米，求它的面积。\n                </div>\n                <div class=\"step\">\n                    <strong>解题步骤：</strong>\n                    <br>1. 已知边长 a = 5 厘米\n                    <br>2. 应用公式：S = a × a\n                    <br>3. 计算：S = 5 × 5 = 25\n                    <br>4. 答案：面积是 25 平方厘米\n                </div>\n            </div>\n        </div>\n        \n        <!-- 图形演示模块 -->\n        <div id=\"demo\" class=\"module\">\n            <h2>🎨 图形演示</h2>\n            <div class=\"demo-container\">\n                <canvas id=\"demoCanvas\" width=\"350\" height=\"350\"></canvas>\n                \n                <div class=\"controls\">\n                    <div class=\"control-group\">\n                        <label>边长：<span id=\"sideValue\">5</span> 厘米</label>\n                        <input type=\"range\" id=\"sideLength\" min=\"1\" max=\"8\" value=\"5\" step=\"0.5\">\n                    </div>\n                    \n                    <div class=\"result-box\">\n                        <div>面积计算</div>\n                        <div id=\"calculation\" style=\"margin-top: 10px; font-size: 0.8em;\">\n                            S = 5 × 5 = 25 平方厘米\n                        </div>\n                    </div>\n                    \n                    <div class=\"hint\">\n                        💡 提示：拖动滑块改变边长，观察面积的变化\n                    </div>\n                </div>\n            </div>\n        </div>\n        \n        <!-- 练习测试模块 -->\n        <div id=\"exercise\" class=\"module\">\n            <h2>✏️ 练习测试</h2>\n            \n            <div class=\"exercise-grid\">\n                <div class=\"exercise-card\" id=\"ex1\">\n                    <h3>练习 1</h3>\n                    <p>一个正方形的边长是 <strong>4 厘米</strong>，它的面积是多少平方厘米？</p>\n                    <input type=\"number\" id=\"answer1\" placeholder=\"输入答案\">\n                    <button onclick=\"checkAnswer(1, 16)\">提交答案</button>\n                    <div class=\"feedback\" id=\"feedback1\"></div>\n                    <div class=\"hint\">提示：S = a × a</div>\n                </div>\n                \n                <div class=\"exercise-card\" id=\"ex2\">\n                    <h3>练习 2</h3>\n                    <p>一个正方形的边长是 <strong>7 厘米</strong>，它的面积是多少平方厘米？</p>\n                    <input type=\"number\" id=\"answer2\" placeholder=\"输入答案\">\n                    <button onclick=\"checkAnswer(2, 49)\">提交答案</button>\n                    <div class=\"feedback\" id=\"feedback2\"></div>\n                    <div class=\"hint\">提示：7 × 7 = ?</div>\n                </div>\n                \n                <div class=\"exercise-card\" id=\"ex3\">\n                    <h3>练习 3</h3>\n                    <p>一个正方形操场的边长是 <strong>10 米</strong>，它的面积是多少平方米？</p>\n                    <input type=\"number\" id=\"answer3\" placeholder=\"输入答案\">\n                    <button onclick=\"checkAnswer(3, 100)\">提交答案</button>\n                    <div class=\"feedback\" id=\"feedback3\"></div>\n                    <div class=\"hint\">提示：10 × 10 = ?</div>\n                </div>\n                \n                <div class=\"exercise-card\" id=\"ex4\">\n                    <h3>练习 4</h3>\n                    <p>一个正方形的面积是 <strong>36 平方厘米</strong>，它的边长是多少厘米？</p>\n                    <input type=\"number\" id=\"answer4\" placeholder=\"输入答案\">\n                    <button onclick=\"checkAnswer(4, 6)\">提交答案</button>\n                    <div class=\"feedback\" id=\"feedback4\"></div>\n                    <div class=\"hint\">提示：几乘几等于36？</div>\n                </div>\n            </div>\n        </div>\n        \n        <footer>\n            <p>🎓 小学三年级数学课件 | 正方形面积</p>\n        </footer>\n    </div>\n    \n    <script>\n        // Canvas 绘图\n        const canvas = document.getElementById('demoCanvas');\n        const ctx = canvas.getContext('2d');\n        \n        // 滑块控制\n        const slider = document.getElementById('sideLength');\n        const sideValueDisplay = document.getElementById('sideValue');\n        const calculationDisplay = document.getElementById('calculation');\n        \n        // 绘制正方形\n        function drawSquare(sideLength) {\n            ctx.clearRect(0, 0, canvas.width, canvas.height);\n            \n            const canvasCenterX = canvas.width / 2;\n            const canvasCenterY = canvas.height / 2;\n            const squareSize = sideLength * 35; // 缩放比例\n            \n            const x = canvasCenterX - squareSize / 2;\n            const y = canvasCenterY - squareSize / 2;\n            \n            // 绘制格子背景（可视化面积单位）\n            ctx.fillStyle = '#f0f0f0';\n            ctx.fillRect(x, y, squareSize, squareSize);\n            \n            // 绘制小格子\n            ctx.strokeStyle = '#ddd';\n            ctx.lineWidth = 1;\n            for (let i = 0; i <= sideLength; i++) {\n                // 垂直线\n                ctx.beginPath();\n                ctx.moveTo(x + i * 35, y);\n                ctx.lineTo(x + i * 35, y + squareSize);\n                ctx.stroke();\n                // 水平线\n                ctx.beginPath();\n                ctx.moveTo(x, y + i * 35);\n                ctx.lineTo(x + squareSize, y + i * 35);\n                ctx.stroke();\n            }\n            \n            // 绘制正方形边框\n            ctx.strokeStyle = '#667eea';\n            ctx.lineWidth = 3;\n            ctx.strokeRect(x, y, squareSize, squareSize);\n            \n            // 填充半透明颜色\n            ctx.fillStyle = 'rgba(102, 126, 234, 0.2)';\n            ctx.fillRect(x, y, squareSize, squareSize);\n            \n            // 标注边长\n            ctx.fillStyle = '#667eea';\n            ctx.font = 'bold 16px Microsoft YaHei';\n            ctx.textAlign = 'center';\n            \n            // 上边标注\n            ctx.fillText(`${sideLength} 厘米`, canvasCenterX, y - 10);\n            \n            // 左边标注\n            ctx.save();\n            ctx.translate(x - 15, canvasCenterY);\n            ctx.rotate(-Math.PI / 2);\n            ctx.fillText(`${sideLength} 厘米`, 0, 0);\n            ctx.restore();\n            \n            // 角标记\n            ctx.fillStyle = '#e74c3c';\n            ctx.beginPath();\n            ctx.arc(x, y, 5, 0, Math.PI * 2);\n            ctx.fill();\n            \n            // 显示小方格数量\n            ctx.fillStyle = '#667eea';\n            ctx.font = 'bold 18px Microsoft YaHei';\n            ctx.fillText(`${sideLength} × ${sideLength} = ${sideLength * sideLength} 个小方格`, canvasCenterX, y + squareSize + 30);\n        }\n        \n        // 更新显示\n        function updateDisplay(sideLength) {\n            sideValueDisplay.textContent = sideLength;\n            const area = sideLength * sideLength;\n            calculationDisplay.innerHTML = `S = ${sideLength} × ${sideLength} = <strong>${area}</strong> 平方厘米`;\n            drawSquare(sideLength);\n        }\n        \n        // 滑块事件\n        slider.addEventListener('input', function() {\n            updateDisplay(parseFloat(this.value));\n        });\n        \n        // 初始绘制\n        updateDisplay(5);\n        \n        // 练习题检查\n        function checkAnswer(exerciseNum, correctAnswer) {\n            const answerInput = document.getElementById(`answer${exerciseNum}`);\n            const feedback = document.getElementById(`feedback${exerciseNum}`);\n            const exerciseCard = document.getElementById(`ex${exerciseNum}`);\n            \n            const userAnswer = parseFloat(answerInput.value);\n            \n            if (isNaN(userAnswer)) {\n                feedback.className = 'feedback show incorrect';\n                feedback.textContent = '❌ 请输入一个数字！';\n                exerciseCard.className = 'exercise-card incorrect';\n                return;\n            }\n            \n            if (Math.abs(userAnswer - correctAnswer) < 0.01) {\n                feedback.className = 'feedback show correct';\n                feedback.textContent = '🎉 回答正确！你真棒！';\n                exerciseCard.className = 'exercise-card correct';\n                \n                // 添加庆祝动画\n                exerciseCard.style.animation = 'none';\n                setTimeout(() => {\n                    exerciseCard.style.animation = 'fadeIn 0.5s ease-out';\n                }, 10);\n            } else {\n                feedback.className = 'feedback show incorrect';\n                feedback.textContent = '❌ 答案不对，再想想！';\n                exerciseCard.className = 'exercise-card incorrect';\n            }\n        }\n        \n        // 回车键提交\n        document.querySelectorAll('input[type=\"number\"]').forEach((input, index) => {\n            input.addEventListener('keypress', function(e) {\n                if (e.key === 'Enter') {\n                    checkAnswer(index + 1, [16, 49, 100, 6][index]);\n                }\n            });\n        });\n    </script>\n</body>\n</html>"
      },
      "executionTime": 2,
      "retries": 0
