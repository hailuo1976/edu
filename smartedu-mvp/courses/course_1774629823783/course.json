         border: 2px solid #667eea;\n            border-radius: 10px;\n            box-shadow: 0 5px 15px rgba(0,0,0,0.1);\n        }\n        \n        .exercise-item {\n            background: #f8f9fa;\n            padding: 25px;\n            border-radius: 15px;\n            margin: 15px 0;\n            border: 2px solid #e0e0e0;\n            transition: all 0.3s;\n        }\n        \n        .exercise-item:hover {\n            border-color: #667eea;\n            box-shadow: 0 5px 20px rgba(102,126,234,0.2);\n        }\n        \n        .exercise-item p {\n            font-size: 1.2em;\n            color: #333;\n            margin-bottom: 15px;\n        }\n        \n        .exercise-input {\n            width: 100px;\n            padding: 10px 15px;\n            font-size: 1.1em;\n            border: 2px solid #667eea;\n            border-radius: 8px;\n            margin-right: 10px;\n        }\n        \n        .btn-check {\n            padding: 10px 25px;\n            font-size: 1.1em;\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n            color: white;\n            border: none;\n            border-radius: 8px;\n            cursor: pointer;\n            transition: all 0.3s;\n        }\n        \n        .btn-check:hover {\n            transform: translateY(-2px);\n            box-shadow: 0 5px 15px rgba(102,126,234,0.4);\n        }\n        \n        .feedback {\n            margin-top: 15px;\n            padding: 10px;\n            border-radius: 8px;\n            font-weight: bold;\n        }\n        \n        .correct {\n            background: #d4edda;\n            color: #155724;\n        }\n        \n        .wrong {\n            background: #f8d7da;\n            color: #721c24;\n        }\n        \n        .unit-label {\n            color: #666;\n            font-size: 0.9em;\n        }\n        \n        .highlight {\n            color: #f5576c;\n            font-weight: bold;\n        }\n        \n        .interactive-area {\n            text-align: center;\n            margin: 20px 0;\n        }\n        \n        .interactive-area input {\n            width: 80px;\n            padding: 8px;\n            font-size: 1.1em;\n            border: 2px solid #667eea;\n            border-radius: 8px;\n            text-align: center;\n        }\n        \n        .draw-btn {\n            padding: 10px 20px;\n            font-size: 1em;\n            background: #667eea;\n            color: white;\n            border: none;\n            border-radius: 8px;\n            cursor: pointer;\n            margin-left: 10px;\n            transition: all 0.3s;\n        }\n        \n        .draw-btn:hover {\n            background: #764ba2;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <h1>📐 正方形的面积</h1>\n        \n        <!-- 概念讲解模块 -->\n        <div id=\"concept\" class=\"module\">\n            <div class=\"module-title\">\n                <span class=\"icon\">💡</span>\n                概念讲解\n            </div>\n            \n            <p style=\"font-size: 1.2em; line-height: 1.8; color: #333;\">\n                <strong>正方形</strong>是一种特殊的四边形，它的<span class=\"highlight\">四条边都相等</span>，四个角都是<span class=\"highlight\">直角</span>。\n            </p>\n            \n            <div class=\"formula-box\">\n                正方形面积 = 边长 × 边长 = 边长²\n            </div>\n            \n            <div class=\"example\">\n                <h3>📝 理解面积的概念</h3>\n                <p>正方形的面积就是正方形所占平面的大小。我们可以用<span class=\"highlight\">边长×边长</span>来计算。</p>\n                <p style=\"margin-top: 10px;\">例如：边长为 3 厘米的正方形，面积 = 3 × 3 = <strong>9 平方厘米</strong></p>\n            </div>\n            \n            <div class=\"steps-container\">\n                <div class=\"step\">\n                    <div class=\"step-num\">1</div>\n                    <div class=\"step-content\">确认正方形的<span class=\"highlight\">边长</span>是多少</div>\n                </div>\n                <div class=\"step\">\n                    <div class=\"step-num\">2</div>\n                    <div class=\"step-content\">应用公式：<span class=\"highlight\">面积 = 边长 × 边长</span></div>\n                </div>\n                <div class=\"step\">\n                    <div class=\"step-num\">3</div>\n                    <div class=\"step-content\">计算结果并标注<span class=\"highlight\">面积单位</span>（如：平方厘米、平方分米、平方米）</div>\n                </div>\n            </div>\n        </div>\n        \n        <!-- 图形演示模块 -->\n        <div id=\"demo\" class=\"module\">\n            <div class=\"module-title\">\n                <span class=\"icon\">🎨</span>\n                图形演示\n            </div>\n            \n            <div class=\"interactive-area\">\n                <label>请输入边长（1-10厘米）：</label>\n                <input type=\"number\" id=\"sideInput\" min=\"1\" max=\"10\" value=\"4\">\n                <button class=\"draw-btn\" onclick=\"drawSquare()\">绘制正方形</button>\n            </div>\n            \n            <div class=\"canvas-container\">\n                <canvas id=\"squareCanvas\" width=\"350\" height=\"350\"></canvas>\n            </div>\n            \n            <div id=\"calculation\" style=\"text-align: center; font-size: 1.3em; margin-top: 15px; color: #667eea; font-weight: bold;\">\n                面积 = 4 × 4 = 16 平方厘米\n            </div>\n        </div>\n        \n        <!-- 练习测试模块 -->\n        <div id=\"exercise\" class=\"module\">\n            <div class=\"module-title\">\n                <span class=\"icon\">✏️</span>\n                练习测试\n            </div>\n            \n            <div class=\"exercise-item\">\n                <p><strong>题目1：</strong>一个正方形花坛的边长是5米，这个花坛的面积是多少平方米？</p>\n                <input type=\"number\" class=\"exercise-input\" id=\"answer1\">\n                <span class=\"unit-label\">平方米</span>\n                <button class=\"btn-check\" onclick=\"checkAnswer(1, 25)\">检查答案</button>\n                <div class=\"feedback\" id=\"feedback1\"></div>\n            </div>\n            \n            <div class=\"exercise-item\">\n                <p><strong>题目2：</strong>一个正方形桌面的面积是49平方分米，这个桌面的边长是多少分米？</p>\n                <input type=\"number\" class=\"exercise-input\" id=\"answer2\">\n                <span class=\"unit-label\">分米</span>\n                <button class=\"btn-check\" onclick=\"checkAnswer(2, 7)\">检查答案</button>\n                <div class=\"feedback\" id=\"feedback2\"></div>\n            </div>\n            \n            <div class=\"exercise-item\">\n                <p><strong>题目3：</strong>小明家有一块正方形地毯，边长是3米，这块地毯的面积是多少平方米？</p>\n                <input type=\"number\" class=\"exercise-input\" id=\"answer3\">\n                <span class=\"unit-label\">平方米</span>\n                <button class=\"btn-check\" onclick=\"checkAnswer(3, 9)\">检查答案</button>\n                <div class=\"feedback\" id=\"feedback3\"></div>\n            </div>\n            \n            <div class=\"exercise-item\">\n                <p><strong>题目4：</strong>一个正方形游泳池的边长是8米，它的面积是多少平方米？</p>\n                <input type=\"number\" class=\"exercise-input\" id=\"answer4\">\n                <span class=\"unit-label\">平方米</span>\n                <button class=\"btn-check\" onclick=\"checkAnswer(4, 64)\">检查答案</button>\n                <div class=\"feedback\" id=\"feedback4\"></div>\n            </div>\n        </div>\n    </div>\n    \n    <script>\n        // 初始化画布\n        window.onload = function() {\n            drawSquare();\n        };\n        \n        // 绘制正方形\n        function drawSquare() {\n            const canvas = document.getElementById('squareCanvas');\n            const ctx = canvas.getContext('2d');\n            const sideLength = parseInt(document.getElementById('sideInput').value) || 4;\n            \n            // 限制边长范围\n            const clampedSide = Math.max(1, Math.min(10, sideLength));\n            \n            // 清空画布\n            ctx.clearRect(0, 0, canvas.width, canvas.height);\n            \n            // 计算缩放比例（每个单位30像素）\n            const scale = 30;\n            const size = clampedSide * scale;\n            const startX = (canvas.width - size) / 2;\n            const startY = (canvas.height - size) / 2;\n            \n            // 绘制网格背景\n            ctx.strokeStyle = '#e0e0e0';\n            ctx.lineWidth = 0.5;\n            for (let i = 0; i <= 10; i++) {\n                // 垂直线\n                ctx.beginPath();\n                ctx.moveTo(startX + i * scale, startY);\n                ctx.lineTo(startX + i * scale, startY + size);\n                ctx.stroke();\n                // 水平线\n                ctx.beginPath();\n                ctx.moveTo(startX, startY + i * scale);\n                ctx.lineTo(startX + size, startY + i * scale);\n                ctx.stroke();\n            }\n            \n            // 绘制正方形\n            ctx.fillStyle = 'rgba(102, 126, 234, 0.3)';\n            ctx.fillRect(startX, startY, size, size);\n            \n            ctx.strokeStyle = '#667eea';\n            ctx.lineWidth = 3;\n            ctx.strokeRect(startX, startY, size, size);\n            \n            // 标注边长\n            ctx.fillStyle = '#333';\n            ctx.font = 'bold 16px Microsoft YaHei';\n            ctx.textAlign = 'center';\n            \n            // 上边标注\n            ctx.fillText(clampedSide + ' 厘米', startX + size/2, startY - 10);\n            \n            // 左边标注\n            ctx.save();\n            ctx.translate(startX - 15, startY + size/2);\n            ctx.rotate(-Math.PI/2);\n            ctx.fillText(clampedSide + ' 厘米', 0, 0);\n            ctx.restore();\n            \n            // 计算并显示面积\n            const area = clampedSide * clampedSide;\n            document.getElementById('calculation').innerHTML = \n                `面积 = ${clampedSide} × ${clampedSide} = <span style=\"color: #f5576c;\">${area}</span> 平方厘米`;\n        }\n        \n        // 检查答案\n        function checkAnswer(questionNum, correctAnswer) {\n            const userAnswer = parseFloat(document.getElementById('answer' + questionNum).value);\n            const feedback = document.getElementById('feedback' + questionNum);\n            \n            if (userAnswer === correctAnswer) {\n                feedback.className = 'feedback correct';\n                feedback.innerHTML = '✓ 回答正确！太棒了！';\n            } else {\n                feedback.className = 'feedback wrong';\n                feedback.innerHTML = '✗ 回答错误，再想想看！提示：正方形面积 = 边长 × 边长';\n            }\n        }\n    </script>\n</body>\n</html>"
      },
      "executionTime": 2,
      "retries": 0
    }
