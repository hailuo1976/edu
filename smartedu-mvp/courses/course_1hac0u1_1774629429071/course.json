  "createdAt": "2026-03-27T16:37:09.071Z",
  "html": "<html lang=\"zh-CN\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>正方形面积计算</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@300;500;700;900&family=Space+Grotesk:wght@400;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        :root {\n            --bg: #0a1612;\n            --bg-secondary: #0f211a;\n            --fg: #e8f4ef;\n            --muted: #6b8f7f;\n            --accent: #f4a261;\n            --accent-glow: rgba(244, 162, 97, 0.3);\n            --card: rgba(15, 33, 26, 0.8);\n            --border: rgba(107, 143, 127, 0.2);\n            --success: #2ec4b6;\n            --error: #e76f51;\n        }\n\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            font-family: 'Noto Sans SC', sans-serif;\n            background: var(--bg);\n            color: var(--fg);\n            min-height: 100vh;\n            overflow-x: hidden;\n        }\n\n        .font-display {\n            font-family: 'Space Grotesk', sans-serif;\n        }\n\n        .bg-pattern {\n            position: fixed;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            pointer-events: none;\n            z-index: 0;\n            background-image: \n                linear-gradient(90deg, var(--border) 1px, transparent 1px),\n                linear-gradient(var(--border) 1px, transparent 1px);\n            background-size: 60px 60px;\n            opacity: 0.3;\n        }\n\n        .glow-orb {\n            position: fixed;\n            border-radius: 50%;\n            filter: blur(100px);\n            pointer-events: none;\n            z-index: 0;\n        }\n\n        .orb-1 {\n            width: 500px;\n            height: 500px;\n            background: radial-gradient(circle, rgba(244, 162, 97, 0.15) 0%, transparent 70%);\n            top: -150px;\n            right: -100px;\n            animation: float 20s ease-in-out infinite;\n        }\n\n        .orb-2 {\n            width: 400px;\n            height: 400px;\n            background: radial-gradient(circle, rgba(46, 196, 182, 0.1) 0%, transparent 70%);\n            bottom: -100px;\n            left: -100px;\n            animation: float 25s ease-in-out infinite reverse;\n        }\n\n        @keyframes float {\n            0%, 100% { transform: translate(0, 0) scale(1); }\n            50% { transform: translate(30px, -30px) scale(1.1); }\n        }\n\n        .nav-tab {\n            position: relative;\n            padding: 0.75rem 1.5rem;\n            font-weight: 500;\n            color: var(--muted);\n            transition: all 0.3s ease;\n            cursor: pointer;\n            background: transparent;\n            border: none;\n            font-size: 1rem;\n        }\n\n        .nav-tab::after {\n            content: '';\n            position: absolute;\n            bottom: 0;\n            left: 50%;\n            width: 0;\n            height: 2px;\n            background: var(--accent);\n            transition: all 0.3s ease;\n            transform: translateX(-50%);\n        }\n\n        .nav-tab:hover {\n            color: var(--fg);\n        }\n\n        .nav-tab.active {\n            color: var(--accent);\n        }\n\n        .nav-tab.active::after {\n            width: 100%;\n        }\n\n        .module-section {\n            display: none;\n            opacity: 0;\n            transform: translateY(20px);\n            transition: opacity 0.4s ease, transform 0.4s ease;\n        }\n\n        .module-section.active {\n            display: block;\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .formula-box {\n            background: linear-gradient(135deg, var(--bg-secondary) 0%, rgba(46, 196, 182, 0.05) 100%);\n            border: 1px solid var(--border);\n            border-radius: 16px;\n            padding: 2rem;\n            position: relative;\n            overflow: hidden;\n        }\n\n        .formula-box::before {\n            content: '';\n            position: absolute;\n            top: -50%;\n            left: -50%;\n            width: 200%;\n            height: 200%;\n            background: conic-gradient(from 0deg, transparent, var(--accent-glow), transparent 30%);\n            animation: rotate 8s linear infinite;\n            opacity: 0.5;\n        }\n\n        @keyframes rotate {\n            100% { transform: rotate(360deg); }\n        }\n\n        .formula-content {\n            position: relative;\n            z-index: 1;\n        }\n\n        .formula {\n            font-size: 2.5rem;\n            font-weight: 700;\n            color: var(--accent);\n            text-align: center;\n            letter-spacing: 0.1em;\n        }\n\n        .canvas-container {\n            background: var(--bg-secondary);\n            border: 1px solid var(--border);\n            border-radius: 16px;\n            overflow: hidden;\n            position: relative;\n        }\n\n        .slider-container input[type=\"range\"] {\n            -webkit-appearance: none;\n            width: 100%;\n            height: 8px;\n            background: var(--bg);\n            border-radius: 4px;\n            outline: none;\n        }\n\n        .slider-container input[type=\"range\"]::-webkit-slider-thumb {\n            -webkit-appearance: none;\n            width: 24px;\n            height: 24px;\n            background: var(--accent);\n            border-radius: 50%;\n            cursor: pointer;\n            box-shadow: 0 0 20px var(--accent-glow);\n            transition: transform 0.2s ease;\n        }\n\n        .slider-container input[type=\"range\"]::-webkit-slider-thumb:hover {\n            transform: scale(1.2);\n        }\n\n        .btn-primary {\n            background: linear-gradient(135deg, var(--accent) 0%, #e76f51 100%);\n            color: var(--bg);\n            font-weight: 700;\n            padding: 1rem 2rem;\n            border-radius: 12px;\n            border: none;\n            cursor: pointer;\n            transition: all 0.3s ease;\n            font-size: 1rem;\n        }\n\n        .btn-primary:hover {\n            transform: translateY(-2px);\n            box-shadow: 0 10px 30px var(--accent-glow);\n        }\n\n        .btn-primary:active {\n            transform: translateY(0);\n        }\n\n        .input-field {\n            background: var(--bg);\n            border: 2px solid var(--border);\n            border-radius: 12px;\n            padding: 1rem 1.5rem;\n            color: var(--fg);\n            font-size: 1.25rem;\n            width: 150px;\n            text-align: center;\n            transition: all 0.3s ease;\n            outline: none;\n        }\n\n        .input-field:focus {\n            border-color: var(--accent);\n            box-shadow: 0 0 20px var(--accent-glow);\n        }\n\n        .result-display {\n            font-size: 3rem;\n            font-weight: 900;\n            background: linear-gradient(135deg, var(--accent) 0%, var(--success) 100%);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .step-card {\n            background: var(--card);\n            border: 1px solid var(--border);\n            border-radius: 12px;\n            padding: 1.5rem;\n            backdrop-filter: blur(10px);\n            transition: all 0.3s ease;\n        }\n\n        .step-card:hover {\n            border-color: var(--accent);\n            transform: translateX(8px);\n        }\n\n        .exercise-card {\n            background: var(--card);\n            border: 2px solid var(--border);\n            border-radius: 20px;\n            padding: 2rem;\n            backdrop-filter: blur(10px);\n            transition: all 0.3s ease;\n        }\n\n        .exercise-card.correct {\n            border-color: var(--success);\n            box-shadow: 0 0 40px rgba(46, 196, 182, 0.2);\n        }\n\n        .exercise-card.wrong {\n            border-color: var(--error);\n            animation: shake 0.5s ease;\n        }\n\n        @keyframes shake {\n            0%, 100% { transform: translateX(0); }\n            20%, 60% { transform: translateX(-10px); }\n            40%, 80% { transform: translateX(10px); }\n        }\n\n        .progress-bar {\n            height: 8px;\n            background: var(--bg);\n            border-radius: 4px;\n            overflow: hidden;\n        }\n\n        .progress-fill {\n            height: 100%;\n            background: linear-gradient(90deg, var(--accent), var(--success));\n            border-radius: 4px;\n            transition: width 0.5s ease;\n        }\n\n        .stagger-in > * {\n            opacity: 0;\n            transform: translateY(30px);\n            animation: staggerIn 0.6s ease forwards;\n        }\n\n        .stagger-in > *:nth-child(1) { animation-delay: 0.1s; }\n        .stagger-in > *:nth-child(2) { animation-delay: 0.2s; }\n        .stagger-in > *:nth-child(3) { animation-delay: 0.3s; }\n        .stagger-in > *:nth-child(4) { animation-delay: 0.4s; }\n        .stagger-in > *:nth-child(5) { animation-delay: 0.5s; }\n\n        @keyframes staggerIn {\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        @media (prefers-reduced-motion: reduce) {\n            *, *::before, *::after {\n                animation-duration: 0.01ms !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n\n        .fade-in {\n            animation: fadeIn 0.5s ease forwards;\n        }\n\n        @keyframes fadeIn {\n            from { opacity: 0; transform: scale(0.9); }\n            to { opacity: 1; transform: scale(1); }\n        }\n\n        .pulse {\n            animation: pulse 2s ease-in-out infinite;\n        }\n\n        @keyframes pulse {\n            0%, 100% { opacity: 1; }\n            50% { opacity: 0.6; }\n        }\n    </style>\n</head>\n<body>\n    <div class=\"bg-pattern\"></div>\n    <div class=\"glow-orb orb-1\"></div>\n    <div class=\"glow-orb orb-2\"></div>\n\n    <div class=\"relative z-10 min-h-screen\">\n        <!-- Header -->\n        <header class=\"py-8 px-4 text-center\">\n            <h1 class=\"font-display text-4xl md:text-5xl font-bold mb-2\" style=\"color: var(--fg);\">\n                正方形面积计算\n            </h1>\n            <p class=\"text-lg\" style=\"color: var(--muted);\">掌握几何基础，探索数学之美</p>\n        </header>\n\n        <!-- Navigation -->\n        <nav class=\"flex justify-center gap-2 mb-8 flex-wrap px-4\">\n            <button class=\"nav-tab active\" data-tab=\"concept\">概念讲解</button>\n            <button class=\"nav-tab\" data-tab=\"demo\">图形演示</button>\n            <button class=\"nav-tab\" data-tab=\"exercise\">练习测试</button>\n        </nav>\n\n        <!-- Main Content -->\n        <main class=\"max-w-5xl mx-auto px-4 pb-16\">\n            \n            <!-- 概念讲解模块 -->\n            <section id=\"concept\" class=\"module-section active\">\n                <div class=\"stagger-in\">\n                    <!-- 公式卡片 -->\n                    <div class=\"formula-box mb-8\">\n                        <div class=\"formula-content\">\n                            <p class=\"text-center mb-4\" style=\"color: var(--muted);\">核心公式</p>\n                            <div class=\"formula font-display\">S = a × a = a²</div>\n                            <p class=\"text-center mt-4\" style=\"color: var(--muted);\">其中 S 表示面积，a 表示边长</p>\n                        </div>\n                    </div>\n\n                    <!-- 概念说明 -->\n                    <div class=\"grid md:grid-cols-2 gap-6 mb-8\">\n                        <div class=\"step-card\">\n                            <div class=\"flex items-center gap-3 mb-4\">\n                                <div class=\"w-10 h-10 rounded-full flex items-center justify-center font-bold\" style=\"background: var(--accent); color: var(--bg);\">1</div>\n                                <h3 class=\"text-xl font-bold\">什么是正方形</h3>\n                            </div>\n                            <p style=\"color: var(--muted);\">正方形是四条边长度相等、四个角都是直角的四边形。它既是特殊的矩形，也是特殊的菱形。</p>\n                        </div>\n                        <div class=\"step-card\">\n                            <div class=\"flex items-center gap-3 mb-4\">\n                                <div class=\"w-10 h-10 rounded-full flex items-center justify-center font-bold\" style=\"background: var(--accent); color: var(--bg);\">2</div>\n                                <h3 class=\"text-xl font-bold\">面积的含义</h3>\n                            </div>\n                            <p style=\"color: var(--muted);\">面积表示平面图形所占平面区域的大小。正方形的面积等于边长乘以边长，即边长的平方。</p>\n                        </div>\n                    </div>\n\n                    <!-- 计算步骤 -->\n                    <div class=\"step-card\">\n                        <div class=\"flex items-center gap-3 mb-6\">\n                            <div class=\"w-10 h-10 rounded-full flex items-center justify-center font-bold\" style=\"background: var(--success); color: var(--bg);\">!</div>\n                            <h3 class=\"text-xl font-bold\">计算步骤</h3>\n                        </div>\n                        <div class=\"grid md:grid-cols-3 gap-4\">\n                            <div class=\"p-4 rounded-lg\" style=\"background: var(--bg);\">\n                                <p class=\"font-bold mb-2\" style=\"color: var(--accent);\">步骤一</p>\n                                <p style=\"color: var(--muted);\">确定正方形的边长 a</p>\n                            </div>\n                            <div class=\"p-4 rounded-lg\" style=\"background: var(--bg);\">\n                                <p class=\"font-bold mb-2\" style=\"color: var(--accent);\">步骤二</p>\n                                <p style=\"color: var(--muted);\">应用公式 S = a²</p>\n                            </div>\n                            <div class=\"p-4 rounded-lg\" style=\"background: var(--bg);\">\n                                <p class=\"font-bold mb-2\" style=\"color: var(--accent);\">步骤三</p>\n                                <p style=\"color: var(--muted);\">计算并写出答案（带单位）</p>\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- 示例 -->\n                    <div class=\"mt-8 step-card\" style=\"border-color: var(--accent);\">\n                        <h3 class=\"text-xl font-bold mb-4\">计算示例</h3>\n                        <p style=\"color: var(--muted);\">若正方形的边长为 5 厘米，求其面积。</p>\n                        <div class=\"mt-4 p-4 rounded-lg\" style=\"background: var(--bg);\">\n                            <p class=\"mb-2\"><span style=\"color: var(--accent);\">解：</span>根据公式 S = a²</p>\n                            <p class=\"mb-2\">S = 5 × 5 = 25</p>\n                            <p style=\"color: var(--success);\">答：正方形的面积为 25 平方厘米。</p>\n                        </div>\n                    </div>\n                </div>\n            </section>\n\n            <!-- 图形演示模块 -->\n            <section id=\"demo\" class=\"module-section\">\n                <div class=\"stagger-in\">\n                    <div class=\"canvas-container mb-6\">\n                        <canvas id=\"squareCanvas\" width=\"600\" height=\"400\"></canvas>\n                    </div>\n\n                    <div class=\"grid md:grid-cols-2 gap-6\">\n                        <div class=\"step-card\">\n                            <h3 class=\"text-xl font-bold mb-4\">调整边长</h3>\n                            <div class=\"slider-container\">\n                                <input type=\"range\" id=\"sideSlider\" min=\"1\" max=\"10\" value=\"5\" step=\"0.5\">\n                            </div>\n                            <p class=\"mt-4 text-center\">\n                                <span style=\"color: var(--muted);\">边长：</span>\n                                <span id=\"sideValue\" class=\"font-bold text-2xl\" style=\"color: var(--accent);\">5</span>\n                                <span style=\"color: var(--muted);\"> 单位</span>\n                            </p>\n                        </div>\n\n                        <div class=\"step-card\">\n                            <h3 class=\"text-xl font-bold mb-4\">计算结果</h3>\n                            <div class=\"text-center\">\n                                <p style=\"color: var(--muted);\">面积 = </p>\n                                <p class=\"result-display font-display\" id=\"areaResult\">25</p>\n                                <p style=\"color: var(--muted);\">平方单位</p>\n                            </div>\n                            <div class=\"mt-4 text-center\" style=\"color: var(--muted);\">\n                                <span id=\"formulaDisplay\">5 × 5 = 25</span>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class=\"mt-6 step-card\">\n                        <h3 class=\"text-xl font-bold mb-4\">单位格子可视化</h3>\n                        <p style=\"color: var(--muted);\">每个小方格代表 1 平方单位。正方形的面积等于它包含的单位格子总数。</p>\n                        <div class=\"mt-4 flex items-center justify-center gap-4\">\n                            <div class=\"flex items-center gap-2\">\n                                <div class=\"w-6 h-6 rounded\" style=\"background: var(--accent); opacity: 0.3;\"></div>\n                                <span style=\"color: var(--muted);\">单位格子</span>\n                            </div>\n                            <div class=\"flex items-center gap-2\">\n                                <div class=\"w-6 h-6 rounded border-2\" style=\"border-color: var(--accent);\"></div>\n                                <span style=\"color: var(--muted);\">正方形边界</span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </section>\n\n            <!-- 练习测试模块 -->\n            <section id=\"exercise\" class=\"module-section\">\n                <div class=\"stagger-in\">\n                    <!-- 进度显示 -->\n                    <div class=\"step-card mb-6\">\n                        <div class=\"flex justify-between items-center mb-4\">\n                            <h3 class=\"text-xl font-bold\">学习进度</h3>\n                            <span id=\"scoreDisplay\" style=\"color: var(--accent);\" class=\"font-bold\">得分: 0 / 0</span>\n                        </div>\n                        <div class=\"progress-bar\">\n                            <div class=\"progress-fill\" id=\"progressFill\" style=\"width: 0%;\"></div>\n                        </div>\n                    </div>\n\n                    <!-- 题目区域 -->\n                    <div class=\"exercise-card\" id=\"exerciseCard\">\n                        <div class=\"text-center mb-6\">\n                            <span class=\"px-4 py-1 rounded-full text-sm font-bold\" style=\"background: var(--accent); color: var(--bg);\">\n                                第 <span id=\"questionNum\">1</span> 题\n                            </span>\n                        </div>\n                        \n                        <div id=\"questionArea\" class=\"text-center mb-8\">\n                            <!-- 题目内容会动态生成 -->\n                        </div>\n\n                        <div class=\"flex flex-col items-center gap-4\">\n                            <div class=\"flex items-center gap-4\">\n                                <span style=\"color: var(--muted);\">面积 = </span>\n                                <input type=\"number\" id=\"answerInput\" class=\"input-field\" placeholder=\"?\" min=\"0\" step=\"0.01\">\n                                <span style=\"color: var(--muted);\">平方单位</span>\n                            </div>\n                            \n                            <div class=\"flex gap-4 mt-4\">\n                                <button class=\"btn-primary\" id=\"submitBtn\">提交答案</button>\n                                <button class=\"btn-primary\" id=\"nextBtn\" style=\"background: var(--bg-secondary); color: var(--fg); border: 2px solid var(--border);\">下一题</button>\n                            </div>\n                        </div>\n\n                        <div id=\"feedback\" class=\"mt-6 text-center text-xl font-bold hidden\"></div>\n                    </div>\n\n                    <!-- 答题提示 -->\n                    <div class=\"mt-6 step-card\">\n                        <h3 class=\"text-xl font-bold mb-4\">答题提示</h3>\n                        <ul class=\"space-y-2\" style=\"color: var(--muted);\">\n                            <li>仔细阅读题目，确定边长数值</li>\n                            <li>使用公式 S = a² 计算面积</li>\n                            <li>输入数值后点击\"提交答案\"</li>\n                            <li>答对继续下一题，答错可重新作答</li>\n                        </ul>\n                    </div>\n                </div>\n            </section>\n        </main>\n    </div>\n\n    <script>\n        // 初始化变量\n        let currentTab = 'concept';\n        let currentQuestion = null;\n        let questionCount = 0;\n        let correctCount = 0;\n        let canvas = null;\n        let ctx = null;\n\n        // DOM加载完成后初始化\n        document.addEventListener('DOMContentLoaded', function() {\n            initCanvas();\n            initTabs();\n            initSlider();\n            initExercise();\n            generateQuestion();\n        });\n\n        // 初始化Canvas\n        function initCanvas() {\n            canvas = document.getElementById('squareCanvas');\n            if (canvas) {\n                ctx = canvas.getContext('2d');\n                resizeCanvas();\n                window.addEventListener('resize', resizeCanvas);\n                drawSquare(5);\n            }\n        }\n\n        // 调整Canvas大小\n        function resizeCanvas() {\n            if (!canvas) return;\n            const container = canvas.parentElement;\n            const rect = container.getBoundingClientRect();\n            canvas.width = Math.min(rect.width, 600);\n            canvas.height = 400;\n            const slider = document.getElementById('sideSlider');\n            if (slider) {\n                drawSquare(parseFloat(slider.value));\n            }\n        }\n\n        // 绘制正方形\n        function drawSquare(side) {\n            if (!ctx || !canvas) return;\n            \n            const width = canvas.width;\n            const height = canvas.height;\n            \n            // 清空画布\n            ctx.clearRect(0, 0, width, height);\n            \n            // 绘制背景网格\n            ctx.strokeStyle = 'rgba(107, 143, 127, 0.1)';\n            ctx.lineWidth = 1;\n            const gridSize = 30;\n            for (let x = 0; x <= width; x += gridSize) {\n                ctx.beginPath();\n                ctx.moveTo(x, 0);\n                ctx.lineTo(x, height);\n                ctx.stroke();\n            }\n            for (let y = 0; y <= height; y += gridSize) {\n                ctx.beginPath();\n                ctx.moveTo(0, y);\n                ctx.lineTo(width, y);\n                ctx.stroke();\n            }\n\n            // 计算正方形尺寸\n            const maxSide = Math.min(width, height) - 100;\n            const squareSize = Math.max(10, (side / 10) * maxSide);\n            const cellSize = Math.max(1, squareSize / side);\n            \n            // 居中位置\n            const startX = (width - squareSize) / 2;\n            const startY = (height - squareSize) / 2;\n\n            // 绘制单位格子\n            ctx.fillStyle = 'rgba(244, 162, 97, 0.2)';\n            ctx.strokeStyle = 'rgba(244, 162, 97, 0.4)';\n            ctx.lineWidth = 1;\n            \n            const intSide = Math.floor(side);\n            const partialCell = side - intSide;\n            \n            for (let i = 0; i < intSide; i++) {\n                for (let j = 0; j < intSide; j++) {\n                    const x = startX + i * cellSize;\n                    const y = startY + j * cellSize;\n                    ctx.fillRect(x, y, cellSize, cellSize);\n                    ctx.strokeRect(x, y, cellSize, cellSize);\n                }\n            }\n\n            // 绘制正方形边框\n            ctx.strokeStyle = '#f4a261';\n            ctx.lineWidth = 3;\n            ctx.strokeRect(startX, startY, squareSize, squareSize);\n\n            // 标注边长\n            ctx.fillStyle = '#e8f4ef';\n            ctx.font = 'bold 16px \"Noto Sans SC\"';\n            ctx.textAlign = 'center';\n            ctx.fillText(side + ' 单位', width / 2, startY + squareSize + 30);\n            ctx.save();\n            ctx.translate(startX - 20, height / 2);\n            ctx.rotate(-Math.PI / 2);\n            ctx.fillText(side + ' 单位', 0, 0);\n            ctx.restore();\n\n            // 标注面积\n            ctx.fillStyle = '#f4a261';\n            ctx.font = 'bold 20px \"Space Grotesk\"';\n            ctx.fillText('S = ' + (side * side), width / 2, startY - 20);\n        }\n\n        // 初始化标签切换\n        function initTabs() {\n            const tabs = document.querySelectorAll('.nav-tab');\n            tabs.forEach(tab => {\n                tab.addEventListener('click', function() {\n                    const targetTab = this.getAttribute('data-tab');\n                    switchTab(targetTab);\n                });\n            });\n        }\n\n        // 切换标签\n        function switchTab(tabId) {\n            currentTab = tabId;\n            \n            // 更新标签状态\n            document.querySelectorAll('.nav-tab').forEach(t => {\n                t.classList.remove('active');\n                if (t.getAttribute('data-tab') === tabId) {\n                    t.classList.add('active');\n                }\n            });\n            \n            // 更新模块显示\n            document.querySelectorAll('.module-section').forEach(s => {\n                s.classList.remove('active');\n            });\n            \n            const targetSection = document.getElementById(tabId);\n            if (targetSection) {\n                targetSection.classList.add('active');\n                \n                // 重新触发动画\n                const staggerContainer = targetSection.querySelector('.stagger-in');\n                if (staggerContainer) {\n                    staggerContainer.querySelectorAll(':scope > *').forEach(child => {\n                        child.style.animation = 'none';\n                        child.offsetHeight;\n                        child.style.animation = null;\n                    });\n                }\n            }\n            \n            // 切换到演示模块时重绘\n            if (tabId === 'demo' && canvas) {\n                resizeCanvas();\n            }\n        }\n\n        // 初始化滑块\n        function initSlider() {\n            const slider = document.getElementById('sideSlider');\n            if (slider) {\n                slider.addEventListener('input', function() {\n                    const value = parseFloat(this.value);\n                    document.getElementById('sideValue').textContent = value;\n                    document.getElementById('areaResult').textContent = (value * value).toFixed(2).replace(/\\.?0+$/, '');\n                    document.getElementById('formulaDisplay').textContent = value + ' × ' + value + ' = ' + (value * value).toFixed(2).replace(/\\.?0+$/, '');\n                    drawSquare(value);\n                });\n            }\n        }\n\n        // 初始化练习模块\n        function initExercise() {\n            const submitBtn = document.getElementById('submitBtn');\n            const nextBtn = document.getElementById('nextBtn');\n            \n            if (submitBtn) {\n                submitBtn.addEventListener('click', checkAnswer);\n            }\n            \n            if (nextBtn) {\n                nextBtn.addEventListener('click', function() {\n                    generateQuestion();\n                });\n            }\n            \n            const answerInput = document.getElementById('answerInput');\n            if (answerInput) {\n                answerInput.addEventListener('keypress', function(e) {\n                    if (e.key === 'Enter') {\n                        checkAnswer();\n                    }\n                });\n            }\n        }\n\n        // 生成题目\n        function generateQuestion() {\n            questionCount++;\n            \n            // 随机生成边长\n            const isDecimal = Math.random() > 0.7;\n            let side;\n            \n            if (isDecimal) {\n                side = (Math.floor(Math.random() * 10) + 1) + Math.floor(Math.random() * 4) * 0.5;\n                if (side === Math.floor(side)) {\n                    side += 0.5;\n                }\n            } else {\n                side = Math.floor(Math.random() * 12) + 1;\n            }\n            \n            currentQuestion = {\n                side: side,\n                answer: parseFloat((side * side).toFixed(2))\n            };\n            \n            // 更新UI\n            const questionNumEl = document.getElementById('questionNum');\n            const questionArea = document.getElementById('questionArea');\n            const answerInput = document.getElementById('answerInput');\n            const feedback = document.getElementById('feedback');\n            const exerciseCard = document.getElementById('exerciseCard');\n            \n            if (questionNumEl) questionNumEl.textContent = questionCount;\n            if (answerInput) {\n                answerInput.value = '';\n                answerInput.disabled = false;\n            }\n            if (feedback) feedback.classList.add('hidden');\n            if (exerciseCard) {\n                exerciseCard.classList.remove('correct', 'wrong');\n            }\n            \n            if (questionArea) {\n                const isInteger = Number.isInteger(side);\n                questionArea.innerHTML = `\n                    <p class=\"text-2xl mb-4\" style=\"color: var(--muted);\">一个正方形的边长为</p>\n                    <p class=\"font-display text-5xl font-bold mb-4\" style=\"color: var(--accent);\">${isInteger ? side : side.toFixed(1)}</p>\n                    <p class=\"text-2xl\" style=\"color: var(--muted);\">单位，求它的面积。</p>\n                `;\n            }\n            \n            // 绘制示意图\n            drawQuestionSquare(side);\n        }\n\n        // 绘制题目示意图\n        function drawQuestionSquare(side) {\n            const questionArea = document.getElementById('questionArea');\n            if (!questionArea) return;\n            \n            // 创建小型Canvas展示题目图形\n            const miniCanvas = document.createElement('canvas');\n            miniCanvas.width = 150;\n            miniCanvas.height = 150;\n            miniCanvas.style.marginTop = '20px';\n            \n            const miniCtx = miniCanvas.getContext('2d');\n            \n            const squareSize = Math.max(20, 100);\n            const startX = (150 - squareSize) / 2;\n            const startY = 20;\n            \n            // 绘制正方形\n            miniCtx.fillStyle = 'rgba(244, 162, 97, 0.2)';\n            miniCtx.fillRect(startX, startY, squareSize, squareSize);\n            miniCtx.strokeStyle = '#f4a261';\n            miniCtx.lineWidth = 2;\n            miniCtx.strokeRect(startX, startY, squareSize, squareSize);\n            \n            // 标注\n            miniCtx.fillStyle = '#e8f4ef';\n            miniCtx.font = '12px \"Noto Sans SC\"';\n            miniCtx.textAlign = 'center';\n            miniCtx.fillText(side + ' 单位', 75, startY + squareSize + 20);\n            \n            questionArea.appendChild(miniCanvas);\n        }\n\n        // 检查答案\n        function checkAnswer() {\n            const answerInput = document.getElementById('answerInput');\n            const feedback = document.getElementById('feedback');\n            const exerciseCard = document.getElementById('exerciseCard');\n            const submitBtn = document.getElementById('submitBtn');\n            \n            if (!answerInput || !currentQuestion) return;\n            \n            const userAnswer = parseFloat(answerInput.value);\n            \n            if (isNaN(userAnswer)) {\n                showFeedback('请输入有效数字', false);\n                return;\n            }\n            \n            answerInput.disabled = true;\n            \n            // 允许一定误差\n            const isCorrect = Math.abs(userAnswer - currentQuestion.answer) < 0.01;\n            \n            if (isCorrect) {\n                correctCount++;\n                showFeedback('正确！面积 = ' + currentQuestion.answer + ' 平方单位', true);\n                if (exerciseCard) {\n                    exerciseCard.classList.add('correct');\n                    exerciseCard.classList.remove('wrong');\n                }\n            } else {\n                showFeedback('错误！正确答案是 ' + currentQuestion.answer + ' 平方单位', false);\n                if (exerciseCard) {\n                    exerciseCard.classList.add('wrong');\n                    exerciseCard.classList.remove('correct');\n                }\n            }\n            \n            updateScore();\n        }\n\n        // 显示反馈\n        function showFeedback(message, isCorrect) {\n            const feedback = document.getElementById('feedback');\n            if (feedback) {\n                feedback.textContent = message;\n                feedback.style.color = isCorrect ? 'var(--success)' : 'var(--error)';\n                feedback.classList.remove('hidden');\n                feedback.classList.add('fade-in');\n            }\n        }\n\n        // 更新分数\n        function updateScore() {\n            const scoreDisplay = document.getElementById('scoreDisplay');\n            const progressFill = document.getElementById('progressFill');\n            \n            if (scoreDisplay) {\n                scoreDisplay.textContent = '得分: ' + correctCount + ' / ' + questionCount;\n            }\n            \n            if (progressFill) {\n                const percentage = questionCount > 0 ? (correctCount / questionCount) * 100 : 0;\n                progressFill.style.width = percentage + '%';\n            }\n        }\n    </script>\n</body>\n</html>",
