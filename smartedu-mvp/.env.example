# SmartEdu MVP - Environment Configuration
# 复制此文件为 .env 并填入实际值

# AI API 配置 (Anthropic兼容接口)
OPENCODE_API_KEY=your_api_key_here
OPENCODE_BASE_URL=https://coding.dashscope.aliyuncs.com/apps/anthropic

# OpenAI 兼容接口配置 (用于Function Calling)
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-plus
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Ollama 本地模型配置 (用于Function Calling，需要本地安装Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# 互联网搜索配置 (可选)
# BING_SEARCH_KEY=your_bing_api_key_here

# 课件生成选项
ENABLE_WEB_SEARCH=false
ENABLE_CODE_VALIDATION=true
SEARCH_RESULT_COUNT=3

# 服务器配置
PORT=3000
NODE_ENV=development
